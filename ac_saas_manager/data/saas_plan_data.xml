<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="plan_standard" model="ac.saas.plan">
        <field name="name">Starter</field>
        <field name="code">standard</field>
        <field name="sequence">10</field>
        <field name="recommended" eval="True"/>
        <field name="description">Recommended for mini leagues or friendly leagues, pool creator.</field>
        <field name="list_price">400.0</field>
        <field name="validity_days">90</field>
        <field name="show_price_on_website" eval="True"/>
        <field name="max_tournaments">1</field>
        <field name="max_teams_per_tournament">8</field>
        <field name="max_players_per_tournament">100</field>
