<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ac_razorpay" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ac.razorpay</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Razorpay" string="Razorpay Payment Gateway" data-key="ac_payment_gateway">
                    <h2>Razorpay Payment Gateway</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ac_razorpay_key_id"/>
                                <div class="text-muted">Key ID from Razorpay Dashboard (Test / Live)</div>
                                <field name="ac_razorpay_key_id" password="False"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ac_razorpay_key_secret"/>
                                <div class="text-muted">Key Secret — keep confidential</div>
                                <field name="ac_razorpay_key_secret" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ac_razorpay_webhook_secret"/>
                                <div class="text-muted">Optional webhook signing secret</div>
                                <field name="ac_razorpay_webhook_secret" password="True"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
