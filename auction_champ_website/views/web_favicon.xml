<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!--
        Backend / website shell: branded title + static favicon in the
        initial HTML (before JavaScript loads).
    -->
    <template id="web_layout_favicon" inherit_id="web.layout" name="AuctionChamp Favicon">
        <xpath expr="//title" position="replace">
            <title t-esc="title or request.env['ir.config_parameter'].sudo().get_param('auction.backend.title', 'AuctionChamp')"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="icon"
                  href="/auction_module/static/description/favicon.png"
                  type="image/png"/>
            <link rel="shortcut icon"
                  href="/auction_module/static/description/favicon.png"
                  type="image/png"/>
        </xpath>
    </template>

</data>
</odoo>
