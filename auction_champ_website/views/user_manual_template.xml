<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="user_manual_page" name="AuctionChamp User Manual">
        <html lang="en">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <t t-call="auction_module.social_preview_head">
                    <t t-set="og_page_key" t-value="'website_manual'"/>
                    <t t-set="og_record" t-value="None"/>
                </t>
                <link rel="shortcut icon" href="/auction_module/static/description/icon.png" type="image/png"/>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous"/>
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="1"/>
                <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;family=Poppins:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
                <link rel="stylesheet" href="/auction_champ_website/static/src/css/auction_website.css"/>
            </head>
            <body>
                <nav class="ac-nav scrolled" id="acNav">
                    <div class="ac-nav-inner">
                        <a href="/" class="ac-nav-logo">
                            <picture>
                                <source srcset="/auction_module/static/description/icon.svg" type="image/svg+xml"/>
                                <img src="/auction_module/static/description/icon.png" alt="AuctionChamp Logo" class="ac-nav-logo-img"/>
                            </picture>
                        </a>
                        <ul class="ac-nav-links">
                            <li><a href="/">Home</a></li>
                            <li><a href="/user-manual" style="color:#f5a623;">User Manual</a></li>
                            <li><a href="/privacy-policy">Privacy Policy</a></li>
                            <li><a href="/terms-and-conditions">Terms &amp; Conditions</a></li>
                            <li><a href="/web" class="ac-nav-login"><i class="fas fa-right-to-bracket"></i>Login</a></li>
                        </ul>
                    </div>
                </nav>

                <section class="ac-policy-section">
                    <div class="ac-manual-layout">
                        <aside class="ac-manual-toc" aria-label="Manual table of contents">
                            <div class="ac-manual-toc-title">On this page</div>
                            <ul class="ac-manual-toc-list" id="acManualToc"></ul>
                        </aside>
                        <div class="ac-policy-container ac-manual-container">
                            <div class="ac-policy-card">
                                <span class="ac-label">Documentation</span>
                                <h1 class="ac-policy-title">AuctionChamp User Manual</h1>
                                <p class="ac-policy-meta">Complete product guide for organisers, auctioneers, and team owners.</p>
                                <div id="acManualContent" class="ac-manual-content">
                                    <p class="ac-manual-loading">Loading manual…</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <footer class="ac-footer" style="padding-top:36px;">
                    <div class="ac-footer-bottom" style="border-top:none; padding-top:0;">
                        <span class="ac-footer-tagline">"Powering the Future of Cricket Auctions &amp; Tournament Management"</span>
                        <span class="ac-footer-copyright">&#169; <t t-esc="current_year"/> AuctionChamp. All rights reserved.</span>
                    </div>
                </footer>

                <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js" crossorigin="anonymous"></script>
                <script src="/auction_champ_website/static/src/js/user_manual.js?v=1"></script>
            </body>
        </html>
    </template>
</odoo>
