<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="user_manual_page" name="AuctionChamp User Manual">
        <html lang="en">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>AuctionChamp Organiser Manual</title>
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="1"/>
                <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
                <link rel="stylesheet" href="/auction_champ_website/static/src/css/user_manual.css?v=4"/>
            </head>
            <body class="ac-manual-body">
                <header class="ac-manual-header">
                    <a href="/web" class="ac-manual-brand" aria-label="AuctionChamp">
                        <img src="/auction_module/static/description/icon.png" alt=""/>
                        <span class="ac-manual-brand-text">
                            <strong>AuctionChamp</strong>
                            <span>Organiser manual</span>
                        </span>
                    </a>
                    <span class="ac-manual-header-spacer"/>
                    <span class="ac-manual-version" id="acManualVersion">Organiser guide</span>
                    <button type="button" class="ac-manual-chapters-btn" id="acManualChapters">Chapters</button>
                    <a class="ac-manual-back" href="/web">Back to app</a>
                </header>

                <div class="ac-manual-backdrop" id="acManualBackdrop"/>

                <div class="ac-manual-shell">
                    <aside class="ac-manual-toc" aria-label="Chapters">
                        <div class="ac-manual-toc-title">Chapters</div>
                        <ul class="ac-manual-toc-list" id="acManualToc"/>
                    </aside>
                    <main>
                        <section class="ac-manual-hero">
                            <p class="ac-manual-kicker">For the signup account</p>
                            <h1>Run the auction from signup to the last player</h1>
                            <p>One working tournament. Teams, players, rules, the showcase, and the squad changes after a sale. The pictures use sample names only.</p>
                        </section>
                        <article id="acManualContent" class="ac-manual-content">
                            <p class="ac-manual-loading">Loading manual…</p>
                        </article>
                    </main>
                </div>

                <footer class="ac-manual-footer">
                    © <t t-esc="current_year"/> AuctionChamp. Organiser manual.
                </footer>

                <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js" crossorigin="anonymous"></script>
                <script src="/auction_champ_website/static/src/js/user_manual.js?v=4"></script>
            </body>
        </html>
    </template>
</odoo>
