<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="live_bid_pad" name="Display Auction Live Bid Pad">
        <div class="ac-bid-hero" id="acBidHero">
            <div class="ac-bid-hero-head">
                <span class="ac-bid-hero-pulse" aria-hidden="true"></span>
                <span class="ac-bid-hero-lbl">Current Bid</span>
                <span class="ac-bid-hero-pts" id="acBidHeroPts">—</span>
            </div>
            <div class="ac-bid-hero-team-row" id="acBidHeroTeamRow">
                <img class="ac-bid-hero-logo" id="acBidHeroLogo" src="" alt=""/>
                <div class="ac-bid-hero-team" id="acBidHeroTeam"></div>
            </div>
            <div class="ac-bid-hero-wait" id="acBidHeroWait">Waiting for opening bid</div>
        </div>
        <button type="button" id="acLiveBidLaunch" class="ac-livebid-launch" aria-label="Open Live Bid">
            LIVE BID
        </button>
        <section id="acLiveBidPad" class="ac-livebid"
                 t-att-data-tournament-id="tournament.id if tournament else ''"
                 t-att-data-csrf="request.csrf_token()">
            <div class="ac-livebid-bar">
                <span class="ac-livebid-title">Live Bid</span>
                <div class="ac-livebid-leadhead" id="acLiveBidLeadHead">
                    <img class="ac-livebid-leadhead-logo" id="acLiveBidLeadLogo" src="" alt=""/>
                    <span class="ac-livebid-leadhead-name" id="acLiveBidLeadName"></span>
                    <span class="ac-livebid-leadhead-pts" id="acLiveBidLeadPts"></span>
                </div>
                <div class="ac-livebid-actions">
                    <button type="button" class="ac-livebid-btn" id="acLiveBidToggle" aria-expanded="false">View all teams</button>
                    <button type="button" class="ac-livebid-close" id="acLiveBidClose" aria-label="Close Bid Panel" title="Close">×</button>
                </div>
            </div>
            <div class="ac-livebid-grid" id="acLiveBidGrid"></div>
        </section>
        <div class="ac-livebid-overlay" id="acLiveBidModal" hidden="hidden">
            <div class="ac-livebid-modal" role="dialog" aria-modal="true" aria-labelledby="acLbModalTeam">
                <button type="button" class="ac-livebid-modal-x" id="acLbModalClose" aria-label="Close">×</button>
                <div class="ac-livebid-modal-head">
                    <img id="acLbModalLogo" src="" alt="" class="ac-livebid-modal-logo"/>
                    <div>
                        <h3 class="ac-livebid-modal-team" id="acLbModalTeam"></h3>
                        <p class="ac-livebid-modal-meta" id="acLbModalMeta"></p>
                    </div>
                </div>
                <div class="ac-livebid-modal-limits">
                    <div>
                        <span>Base</span>
                        <strong id="acLbModalBase"></strong>
                    </div>
                    <div>
                        <span>Max call</span>
                        <strong id="acLbModalMax"></strong>
                    </div>
                </div>
                <label class="ac-livebid-modal-label" for="acLbBidInput">Points</label>
                <div class="ac-livebid-modal-row">
                    <button type="button" class="ac-livebid-adj" id="acLbDec">−</button>
                    <input type="number" id="acLbBidInput" min="0" step="1"/>
                    <button type="button" class="ac-livebid-adj" id="acLbInc">+</button>
                </div>
                <div class="ac-livebid-presets" id="acLbPresets"></div>
                <p class="ac-livebid-hint" id="acLbHint"></p>
                <button type="button" class="ac-livebid-place" id="acLbPlace">Place Bid</button>
            </div>
        </div>
        <div class="ac-livebid-overlay ac-livebid-info-overlay" id="acLiveBidInfo" hidden="hidden">
            <div class="ac-livebid-modal ac-livebid-info-card" role="dialog" aria-modal="true" aria-labelledby="acLbInfoName">
                <button type="button" class="ac-livebid-modal-x" id="acLbInfoClose" aria-label="Close">×</button>
                <div class="ac-livebid-info-head">
                    <img id="acLbInfoLogo" src="" alt="" class="ac-livebid-info-logo"/>
                    <div class="ac-livebid-info-id">
                        <h3 class="ac-livebid-info-name" id="acLbInfoName"></h3>
                        <p class="ac-livebid-info-mgr" id="acLbInfoMgr"></p>
                        <span class="ac-livebid-info-badge" id="acLbInfoLead" hidden="hidden">Leading bid</span>
                    </div>
                </div>
                <div class="ac-livebid-info-rows" id="acLbInfoRows"></div>
                <p class="ac-livebid-info-note" id="acLbInfoNote"></p>
            </div>
        </div>
        <div class="ac-livebid-toast" id="acLiveBidToast"></div>
        <link rel="stylesheet" href="/auction_auctioneer/static/src/css/display_live_bid.css?v=56"/>
        <t t-if="not ac_livebid_rollcall">
            <link rel="stylesheet" href="/auction_auctioneer/static/src/css/display_showcase.css?v=13"/>
        </t>
        <script src="/auction_auctioneer/static/src/js/display_live_bid.js?v=48"></script>
    </template>

    <!-- Under player profile, above Unsold / Sell / Next.
         Only inject when the session user has Auctioneer — otherwise Current Bid /
         Live Bid leave empty chrome (especially painful on small screens). -->
    <delete model="ir.ui.view" search="[('key','in',['auction_auctioneer.live_bid_pad_vanilla','auction_auctioneer.live_bid_pad_butterscotch','auction_auctioneer.live_bid_pad_strawberry','auction_auctioneer.live_bid_pad_cherry','auction_auctioneer.live_bid_pad_pistah','auction_auctioneer.live_bid_pad_lemon','auction_auctioneer.live_bid_pad_blackberry','auction_auctioneer.live_bid_phone_id_lemon','auction_auctioneer.live_bid_phone_id_strawberry'])]"/>
    <delete model="ir.model.data" search="[('module','=','auction_auctioneer'),('name','in',['live_bid_pad_vanilla','live_bid_pad_butterscotch','live_bid_pad_strawberry','live_bid_pad_cherry','live_bid_pad_pistah','live_bid_pad_lemon','live_bid_pad_blackberry','live_bid_phone_id_lemon','live_bid_phone_id_strawberry'])]"/>

    <template id="live_bid_pad_hud" inherit_id="auction_module.player_template_hud">
        <xpath expr="//div[hasclass('hud-actions')]" position="before">
            <t t-if="request.env.user.has_group('auction_auctioneer.group_auctioneer')">
                <t t-call="auction_auctioneer.live_bid_pad"/>
            </t>
        </xpath>
    </template>

    <!-- Roll Call: live bid only inside the player drawer — do not load
         display_showcase.css (that file restyles Lucky Dip / slot pages). -->
    <template id="live_bid_pad_rollcall" inherit_id="auction_module.player_sequence_selector">
        <xpath expr="//div[@id='pcBody']" position="after">
            <t t-if="request.env.user.has_group('auction_auctioneer.group_auctioneer')">
                <div class="pc-livebid-wrap" id="pcLiveBidWrap" data-player-zone="1">
                    <t t-set="ac_livebid_rollcall" t-value="True"/>
                    <t t-call="auction_auctioneer.live_bid_pad"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
