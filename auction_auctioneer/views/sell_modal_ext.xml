<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Extends auction_module.player_sell_modal so that when the auctioneer has
    already locked a bid via the Auctioneer Console (current_bid +
    current_bid_team_id are set on the player), opening the Sell modal will
    automatically select that team and pre-fill the locked bid amount.

    The JS wraps window.openSellModal:
      1. Calls the original openSellModal() which kicks off async team loading.
      2. Fetches the locked bid info from /auction/auctioneer/locked-bid.
      3. Uses a MutationObserver on #smTeamBadges to detect when badges are
         rendered, then clicks the matching badge (triggering the full
         smSelectTeam flow) and overwrites the points input with the locked
         bid amount.
-->
<template
    id="player_sell_modal_bid_ext"
    inherit_id="auction_module.player_sell_modal"
    name="Sell Modal – Auto-fill Locked Bid">

    <xpath expr="//script[contains(., 'window.openSellModal')]" position="after">
        <script>//<![CDATA[
(function () {
    'use strict';

    var _origOpen = window.openSellModal;

    window.openSellModal = function () {
        /* Team list + locked bid now arrive in one console_call. Extra
           /auction/auctioneer/locked-bid round-trip is no longer needed. */
        _origOpen();
    };
})();
        //]]></script>
    </xpath>

</template>
</odoo>
