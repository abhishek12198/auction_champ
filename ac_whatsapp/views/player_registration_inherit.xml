<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="player_registration_email_field"
              inherit_id="auction_module.player_registration_form">
        <xpath expr="//input[@id='contactFull']" position="after">
            <div class="reg-field" style="margin-top:1rem;">
                <label class="reg-label" for="playerEmail">
                    Email
                    <span style="opacity:.55;font-weight:500;">(optional — card PDF will be emailed)</span>
                </label>
                <input type="email" id="playerEmail" name="email" class="reg-input"
                       placeholder="you@example.com" autocomplete="email"/>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('reg-success-downloads')]" position="before">
            <t t-if="whatsapp_confirm_url">
                <div class="reg-wa-confirm" style="margin:1.25rem auto 0;max-width:520px;text-align:center;">
                    <a t-att-href="whatsapp_confirm_url"
                       target="_blank" rel="noopener noreferrer"
                       class="reg-btn-submit"
                       style="display:inline-flex;align-items:center;justify-content:center;gap:.65rem;
                              background:#25D366;border:none;box-shadow:0 4px 18px rgba(37,211,102,.35);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                             fill="currentColor" aria-hidden="true">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                        Send confirmation on WhatsApp
                    </a>
                    <p style="margin-top:.65rem;font-size:.82rem;opacity:.7;line-height:1.5;">
                        Opens WhatsApp with your confirmation message and a secure player-card PDF link.
                        Tap send to keep it in your chat.
                    </p>
                    <t t-if="registration_confirm_sent">
                        <p style="margin-top:.4rem;font-size:.82rem;color:#16a34a;font-weight:600;">
                            A confirmation email with your player card PDF was also sent.
                        </p>
                    </t>
                </div>
            </t>
        </xpath>

        <xpath expr="//a[hasclass('reg-success-dl') and not(hasclass('reg-success-dl--status'))]" position="replace">
            <a t-att-href="secure_card_url or ('/%s/player/card/%s' % (db_name, player_id))"
               class="reg-btn-submit reg-success-dl"
               target="_blank" rel="noopener"
               title="Download Player Card (PDF)"
               aria-label="Download Player Card PDF">
                <svg class="reg-success-dl-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="12" y1="18" x2="12" y2="12"/>
                    <polyline points="9 15 12 18 15 15"/>
                </svg>
                <span class="reg-success-dl-label">Download Player Card (PDF)</span>
            </a>
        </xpath>
    </template>
</odoo>
