<!-- ═════════════════════════════════════════════════════════════════════
     SHARED: Download toolbar + html2canvas
     t-call this from the <body> of every squad template.
═════════════════════════════════════════════════════════════════════════ -->
<template id="squad_tmpl_dl_bar" name="Squad Download Bar">
<style><![CDATA[
.sq-dl-bar{position:fixed;top:0;left:0;right:0;z-index:10000;
    display:flex;align-items:center;justify-content:space-between;
    background:rgba(15,15,15,.92);backdrop-filter:blur(8px);
    padding:8px 20px;border-bottom:1px solid rgba(255,255,255,.1);}
.sq-dl-title{color:#fff;font-family:Arial,sans-serif;font-size:13px;font-weight:600;letter-spacing:.5px;}
.sq-dl-note{color:rgba(255,255,255,.5);font-family:Arial,sans-serif;font-size:11px;margin-left:12px;}
.sq-dl-actions{display:flex;gap:8px;align-items:center;}
.sq-dl-btn{border:none;border-radius:6px;padding:7px 16px;font-size:12px;font-weight:700;
    cursor:pointer;letter-spacing:.5px;transition:opacity .15s;}
.sq-dl-btn:hover{opacity:.85;}
.sq-dl-btn:disabled{opacity:.5;cursor:wait;}
.sq-dl-png{background:#22c55e;color:#fff;}
.sq-dl-jpg{background:#3b82f6;color:#fff;}
.sq-dl-print{background:#6b7280;color:#fff;}
@media print{.sq-dl-bar{display:none!important;}}
]]></style>
<div class="sq-dl-bar">
    <div style="display:flex;align-items:center;">
        <span class="sq-dl-title">&#127951; Squad Designer &#8212; Preview</span>
        <span class="sq-dl-note">Right-click the card for browser Save-As, or use the buttons below.</span>
    </div>
    <div class="sq-dl-actions">
        <button class="sq-dl-btn sq-dl-png" onclick="sqDownload('png',this)">&#11015; Download PNG</button>
        <button class="sq-dl-btn sq-dl-jpg" onclick="sqDownload('jpeg',this)">&#11015; Download JPEG</button>
        <button class="sq-dl-btn sq-dl-print" onclick="window.print()">&#128424; Print</button>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>//<![CDATA[
function sqDownload(fmt, btn) {
    var area = document.getElementById('sqArea');
    if (!area) { alert('Print area not found.'); return; }
    var orig = btn.textContent; btn.textContent = '⏳ Rendering…'; btn.disabled = true;
    var opts = { scale: 2, useCORS: true, allowTaint: false,
                 backgroundColor: null, logging: false };
    if (typeof html2canvas === 'undefined') {
        btn.textContent = orig; btn.disabled = false;
        alert('Download library not loaded. Please check your internet connection or use Print instead.');
        return;
    }
    html2canvas(area, opts).then(function(canvas) {
        var link = document.createElement('a');
        var name = (area.dataset.team || 'squad').replace(/\s+/g,'_');
        link.download = name + '_squad.' + fmt;
        link.href = canvas.toDataURL(fmt === 'jpeg' ? 'image/jpeg' : 'image/png', 0.96);
        link.click();
        btn.textContent = orig; btn.disabled = false;
    }).catch(function(e) {
        console.error(e);
        btn.textContent = orig; btn.disabled = false;
        alert('Rendering failed. Try Print instead.');
    });
}
]]></script>
</template>


<!-- ═════════════════════════════════════════════════════════════════════
     TEMPLATE 1 — IPL Classic  (Dark Navy + Gold)
═════════════════════════════════════════════════════════════════════════ -->
<template id="squad_tmpl_ipl_classic" name="Squad Template: IPL Classic">
<html lang="en">
<head>
<meta charset="UTF-8"/>
    <t t-call="auction_module.page_head_favicon"/>
<title><t t-out="squad.team_name"/> – Squad Card</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Rajdhani:wght@400;600;700&amp;family=Montserrat:wght@700;900&amp;display=swap" rel="stylesheet"/>
<style><![CDATA[
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#070d1a;display:flex;flex-direction:column;align-items:center;padding-top:60px;font-family:'Rajdhani',Arial,sans-serif;}
#sqArea{
    width:1080px;min-height:1350px;position:relative;overflow:hidden;
    background:radial-gradient(ellipse 80% 60% at 0% 0%,#1a3564 0%,#0d1b2e 55%),
               linear-gradient(160deg,#0e1d38 0%,#0a1220 100%);
    color:#fff;padding-bottom:32px;}
/* Gold top-right decoration */
#sqArea::before{content:'';position:absolute;top:-80px;right:-80px;width:420px;height:420px;
    border:3px solid rgba(255,215,0,.12);border-radius:50%;pointer-events:none;}
#sqArea::after{content:'';position:absolute;top:-40px;right:-40px;width:280px;height:280px;
    border:3px solid rgba(255,215,0,.08);border-radius:50%;pointer-events:none;}
/* Header */
.ipl-header{display:flex;align-items:center;padding:24px 24px 18px;
    border-bottom:2px solid rgba(255,215,0,.25);}
.ipl-logo-wrap{width:80px;height:80px;flex-shrink:0;margin-right:18px;
    display:flex;align-items:center;justify-content:center;}
.ipl-logo{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 0 12px rgba(255,215,0,.4));}
.ipl-logo-ph{width:80px;height:80px;border-radius:50%;border:2px solid rgba(255,215,0,.4);
    display:flex;align-items:center;justify-content:center;
    font-size:36px;color:rgba(255,215,0,.5);}
.ipl-titles{flex:1;}
.ipl-team{font-family:'Bebas Neue','Impact',sans-serif;font-size:42px;
    color:#FFD700;letter-spacing:3px;line-height:1;
    text-shadow:0 0 30px rgba(255,215,0,.4);}
.ipl-tourn{font-size:16px;font-weight:600;color:rgba(255,255,255,.55);
    letter-spacing:8px;text-transform:uppercase;margin-top:6px;}
.ipl-tagline{font-size:13px;color:rgba(255,215,0,.55);font-style:italic;margin-top:4px;}
.ipl-season-box{flex-shrink:0;text-align:center;
    background:rgba(255,215,0,.08);border:1.5px solid rgba(255,215,0,.35);
    border-radius:10px;padding:10px 18px;}
.ipl-season-yr{font-family:'Bebas Neue','Impact',sans-serif;font-size:34px;
    color:#FFD700;line-height:1;}
.ipl-season-lbl{font-size:10px;color:rgba(255,255,255,.45);letter-spacing:5px;text-transform:uppercase;}
/* Players */
.ipl-players{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:20px 24px 28px;}
.ipl-card{display:flex;flex-direction:column;align-items:stretch;padding:0 0 12px;
    background:rgba(255,255,255,.035);border:1px solid rgba(255,215,0,.13);
    border-radius:10px;position:relative;overflow:hidden;}
.ipl-card-photo{width:100%;height:160px;border-radius:0;border:none;
    border-bottom:3px solid #FFD700;
    overflow:hidden;flex-shrink:0;background:rgba(255,255,255,.06);
    display:flex;align-items:center;justify-content:center;margin-bottom:8px;position:relative;}

.ipl-photo-ph{color:rgba(255,255,255,.15);font-size:44px;line-height:1;}
.ipl-badge{position:absolute;top:-3px;left:-3px;width:22px;height:22px;border-radius:50%;
    font-size:8px;font-weight:900;display:flex;align-items:center;justify-content:center;
    background:#FFD700;color:#0d1b2e;}
.ipl-vc-badge{background:#c0c0c0;color:#333;}
.ipl-jno{position:absolute;bottom:-3px;right:-3px;background:#0d6efd;color:#fff;
    width:22px;height:22px;border-radius:50%;font-size:9px;font-weight:900;
    display:flex;align-items:center;justify-content:center;}
.ipl-card-name{font-size:13px;font-weight:700;color:#fff;text-align:center;
    text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px;line-height:1.2;padding:0 6px;}
.ipl-card-role{font-size:11px;color:rgba(255,215,0,.7);text-align:center;margin-bottom:5px;padding:0 6px;}
.ipl-card-cat{font-size:9px;font-weight:700;letter-spacing:1.5px;
    padding:2px 8px;border-radius:3px;text-transform:uppercase;
    background:rgba(255,255,255,.08);color:rgba(255,255,255,.6);}
/* Footer */
.ipl-footer{text-align:center;padding:10px;font-size:10px;color:rgba(255,255,255,.2);
    letter-spacing:2px;text-transform:uppercase;}
]]></style>
</head>
<body>
<t t-call="squad_designer.squad_tmpl_dl_bar"/>
<div id="sqArea" t-att-data-team="squad.team_name">
    <!-- Header -->
    <div class="ipl-header">
        <div class="ipl-logo-wrap">
            <t t-if="squad.team_logo">
                <img class="ipl-logo" t-attf-src="/web/image/squad.print/#{squad.id}/team_logo"
                     crossorigin="anonymous" alt="logo"/>
            </t>
            <t t-else=""><div class="ipl-logo-ph">&#127942;</div></t>
        </div>
        <div class="ipl-titles">
            <div class="ipl-team"><t t-out="squad.team_name or 'TEAM NAME'"/></div>
            <div class="ipl-tourn"><t t-out="squad.name or ''"/></div>
            <t t-if="squad.tagline">
                <div class="ipl-tagline">"<t t-out="squad.tagline"/>"</div>
            </t>
        </div>
        <div class="ipl-season-box">
            <div class="ipl-season-yr"><t t-out="squad.season or '2025'"/></div>
            <div class="ipl-season-lbl">Season</div>
        </div>
    </div>
    <!-- Players grid -->
    <div class="ipl-players">
        <t t-foreach="squad.player_ids" t-as="p">
            <div class="ipl-card">
                <div class="ipl-card-photo"
                     t-attf-style="background-image:url(/web/image/squad.print.player/#{p.id}/photo);background-size:contain;background-repeat:no-repeat;background-position:center center;">
                    <t t-if="not p.photo"><div class="ipl-photo-ph">&#128100;</div></t>
                    <t t-if="p.is_captain"><div class="ipl-badge">C</div></t>
                    <t t-elif="p.is_vc"><div class="ipl-badge ipl-vc-badge">VC</div></t>
                    <t t-if="p.jersey_no"><div class="ipl-jno"><t t-out="p.jersey_no"/></div></t>
                </div>
                <div class="ipl-card-name"><t t-out="p.name"/></div>
                <div class="ipl-card-role"><t t-out="p.role or ''"/></div>
                <t t-if="p.category_id">
                    <div class="ipl-card-cat"
                         t-attf-style="background:#{p.category_id.color or '#444'};color:#fff;">
                        <t t-out="p.category_id.code or p.category_id.name"/>
                    </div>
                </t>
            </div>
        </t>
    </div>
    <div class="ipl-footer">Squad Designer &#8226; <t t-out="squad.team_name"/> &#8226; <t t-out="squad.season or ''"/></div>
</div>
</body>
</html>
</template>


