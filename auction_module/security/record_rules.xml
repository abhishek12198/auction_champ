<odoo>
<data noupdate="0">

    <!--
        TOURNAMENT-BASED DATA ISOLATION
        ================================
        Auction Administrator → all records  [(1, '=', 1)]
        All other auction groups → only user.tournament_id
          Domain: [('tournament_id', 'in', user.tournament_id.ids)]
          (or ('id', '=', ...) for auction.tournament)

        When Active Tournament is empty, '=' False alone would match
        unassigned rows — the Python _search mixin blocks that case.
        Rules still use tournament_id so list/form access matches.
    -->

    <!-- ═══════════════════════════════════════════════════════
         auction.tournament
    ═══════════════════════════════════════════════════════════ -->
    <record id="rule_tournament_own" model="ir.rule">
        <field name="name">Tournament: own tournament only</field>
        <field name="model_id" ref="auction_module.model_auction_tournament"/>
        <field name="groups" eval="[(4, ref('auction_module.group_auction_group'))]"/>
        <field name="domain_force">[('id', 'in', user.tournament_id.ids)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_tournament_admin_all" model="ir.rule">
        <field name="name">Tournament: admin sees all</field>
        <field name="model_id" ref="auction_module.model_auction_tournament"/>
