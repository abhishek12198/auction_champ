<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Redis is optional. Default off so auctions keep working on ORM polling. -->
        <record id="config_auction_redis_enabled" model="ir.config_parameter">
            <field name="key">auction.redis.enabled</field>
            <field name="value">False</field>
        </record>
        <record id="config_auction_redis_uri" model="ir.config_parameter">
            <field name="key">auction.redis.uri</field>
            <field name="value">redis://127.0.0.1:6379/1</field>
        </record>
        <!-- Phase 3 SSE: frontend uses this; gateway always serves /events. -->
        <record id="config_auction_sse_enabled" model="ir.config_parameter">
            <field name="key">auction.sse.enabled</field>
            <field name="value">False</field>
        </record>
    </data>
</odoo>
