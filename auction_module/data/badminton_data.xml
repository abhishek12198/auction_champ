<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Badminton strengths only (sport=badminton) — never appear on football forms -->
        <record id="bm_str_smash" model="auction.player.strength">
            <field name="name">Smash</field>
            <field name="icon">💥</field>
            <field name="sequence">10</field>
            <field name="sport">badminton</field>
        </record>
        <record id="bm_str_speed" model="auction.player.strength">
            <field name="name">Speed</field>
            <field name="icon">⚡</field>
            <field name="sequence">20</field>
            <field name="sport">badminton</field>
        </record>
        <record id="bm_str_net_play" model="auction.player.strength">
            <field name="name">Net Play</field>
            <field name="icon">🏸</field>
            <field name="sequence">30</field>
            <field name="sport">badminton</field>
        </record>
        <record id="bm_str_defense" model="auction.player.strength">
            <field name="name">Defense</field>
            <field name="icon">🛡️</field>
            <field name="sequence">40</field>
            <field name="sport">badminton</field>
        </record>
        <record id="bm_str_stamina" model="auction.player.strength">
            <field name="name">Stamina</field>
            <field name="icon">🔋</field>
            <field name="sequence">50</field>
            <field name="sport">badminton</field>
        </record>
        <record id="bm_str_drop" model="auction.player.strength">
            <field name="name">Drop Shot</field>
            <field name="icon">🎯</field>
            <field name="sequence">60</field>
            <field name="sport">badminton</field>
        </record>
        <record id="bm_str_footwork" model="auction.player.strength">
            <field name="name">Footwork</field>
            <field name="icon">👟</field>
            <field name="sequence">70</field>
            <field name="sport">badminton</field>
        </record>
        <record id="bm_str_partner" model="auction.player.strength">
            <field name="name">Partnership</field>
            <field name="icon">🤝</field>
            <field name="sequence">80</field>
            <field name="sport">badminton</field>
        </record>

    </data>
</odoo>
