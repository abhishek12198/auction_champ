<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auction_reactivate_tournament_wizard_form" model="ir.ui.view">
        <field name="name">auction.reactivate.tournament.wizard.form</field>
        <field name="model">auction.reactivate.tournament.wizard</field>
        <field name="arch" type="xml">
            <form string="Re-Activate Tournament" class="o_dt_wizard o_ra_wizard">
                <field name="tournament_id" invisible="1"/>
                <field name="player_count" invisible="1"/>
                <field name="team_count" invisible="1"/>
                <field name="auction_count" invisible="1"/>
                <field name="history_count" invisible="1"/>
                <field name="advertiser_count" invisible="1"/>
                <field name="deleted_player_count" invisible="1"/>

                <div class="dt-hero">
                    <div class="dt-hero-icon"><i class="fa fa-undo"/></div>
                    <div class="dt-hero-copy">
                        <div class="dt-hero-kicker">Restore archived tournament</div>
                        <div class="dt-hero-title">Re-Activate Tournament</div>
                        <div class="dt-hero-sub">
                            This restores <strong><field name="tournament_name" readonly="1" nolabel="1"/></strong>
                            and the archived auction data listed below.
                            Public links (registration, live board, projector) will work again.
                        </div>
                    </div>
                </div>

                <div class="dt-list-wrap">
                    <div class="dt-list-title">We will re-activate / unarchive the following:</div>
                    <ul class="dt-list">
                        <li>
                            <strong>Tournament</strong> — show it again in active lists (removed from Archived).
                        </li>
                        <li>
                            <strong>Players</strong> — all draft, in-auction, sold, unsold and icon players
                            (<field name="player_count" readonly="1" nolabel="1"/> records).
                        </li>
                        <li>
                            <strong>Teams</strong> — squads, purses and assigned players
                            (<field name="team_count" readonly="1" nolabel="1"/> teams).
                        </li>
                        <li>
                            <strong>Auction rules</strong> — purses, bid slabs and tier limits
                            (<field name="auction_count" readonly="1" nolabel="1"/> team rule records).
                        </li>
                        <li>
                            <strong>Auction history</strong> — sold / unsold log
                            (<field name="history_count" readonly="1" nolabel="1"/> records).
                        </li>
                        <li>
                            <strong>Advertisers / sponsors</strong>
                            (<field name="advertiser_count" readonly="1" nolabel="1"/> records).
                        </li>
                        <li>
                            <strong>Deleted-player recycle bin</strong> — cannot be restored
                            (<field name="deleted_player_count" readonly="1" nolabel="1"/> records remain).
                            Players permanently removed at deactivate stay gone.
                        </li>
                        <li>
                            <strong>Public access</strong> — player registration, live board, bid summary and projector URLs for this tournament.
                        </li>
                    </ul>
                </div>

                <div class="dt-warn">
                    <div class="dt-warn-copy">
                        <div class="dt-warn-title">Consent required</div>
                        <div class="dt-warn-text">
                            Re-activating brings this tournament’s archived data back into day-to-day use.
                            Recycle-bin players that were deleted on deactivate cannot be restored.
                            Tick the box below to confirm you want to proceed.
                        </div>
                    </div>
                    <div class="dt-consent">
                        <field name="accept_consent" nolabel="1"/>
                        <span>I have read the list above and I consent to re-activate this tournament and its archived data.</span>
                    </div>
                </div>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Re-Activate Tournament"
                            class="btn-success"
                            attrs="{'invisible': [('accept_consent', '=', False)]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
