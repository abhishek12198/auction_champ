<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auction_player_upload_wizard_form" model="ir.ui.view">
        <field name="name">auction.player.upload.wizard.form</field>
        <field name="model">auction.player.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Players">
                <field name="state" invisible="1"/>
                <field name="tournament_type" invisible="1"/>
                <group attrs="{'invisible': [('state', '=', 'done')]}">
                    <group string="Tournament">
                        <field name="tournament_id"/>
                    </group>
                    <group string="1. Download Template">
                        <div colspan="2" class="text-muted"
                             attrs="{'invisible': [('tournament_type', '=', 'kabaddi')]}">
                            Download the Excel for this tournament. The file has three sheets:
                            <b>Players</b> (data), <b>Field Guide</b> (column type: free text / selection / Many2one / Many2many),
                            and <b>Reference Lists</b> (exact allowed values from master data and this tournament's tiers).
                            Fill Players using those lists so Tier, Positions, Styles, Strengths, Preferred Foot, and Work Rate match.
                            Photos ZIP optional: 1.jpg, 2.png … matching Excel row order.
                        </div>
                        <div colspan="2" class="text-muted"
                             attrs="{'invisible': [('tournament_type', '!=', 'kabaddi')]}">
                            Download the Excel for this Kabaddi tournament. The file has three sheets:
                            <b>Players</b> (data), <b>Field Guide</b>, and <b>Reference Lists</b>.
                            Role must be Defender, Rider, or AllRounder. Previous Club / Current Club is free text.
                            Photos ZIP optional: 1.jpg, 2.png … matching Excel row order.
                        </div>
                        <button name="action_download_template"
                                type="object"
                                string="Download Excel Template"
                                class="btn-secondary"
                                icon="fa-download"
                                colspan="2"/>
                        <field name="template_file"
                               filename="template_filename"
                               attrs="{'invisible': [('template_file', '=', False)]}"/>
                        <field name="template_filename" invisible="1"/>
                    </group>
                    <group string="2. Upload Files">
                        <field name="excel_file" filename="excel_filename"/>
                        <field name="excel_filename" invisible="1"/>
                        <field name="photos_zip" filename="photos_zip_filename"/>
                        <field name="photos_zip_filename" invisible="1"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('state', '!=', 'done')]}">
                    <field name="created_count"/>
                    <field name="photo_count"/>
                    <field name="result_message" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import Players"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button string="Close" class="btn-primary" special="cancel"
                            attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
