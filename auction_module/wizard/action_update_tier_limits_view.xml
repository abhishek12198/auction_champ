<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_update_tier_limits_form" model="ir.ui.view">
            <field name="name">auction.update.tier.limits.form</field>
            <field name="model">auction.update.tier.limits</field>
            <field name="arch" type="xml">
                <form string="Update Tier Limits &amp; Bid Slabs" class="custom_wizard_popup o_update_tier_slab_wiz">

                    <div class="alert alert-info" role="alert"
                         style="margin:0 0 12px;padding:10px 14px;border-radius:8px;">
                        <i class="fa fa-info-circle"/>
                        Use the toggles to choose what to change. Untoggled fields stay as they are
                        on every selected auction.
                    </div>

                    <notebook>
                        <!-- Tab 1: auctions -->
                        <page string="Auctions" name="auctions">
                            <field name="auction_ids" nolabel="1" readonly="1"
                                   options="{'no_open': True}">
                                <tree create="0" delete="0" edit="0">
                                    <field name="team_id" string="Team"/>
                                    <field name="manager" string="Owner"/>
                                    <field name="total_point" string="Purse"/>
                                    <field name="max_players" string="Squad Size"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Tab 2: tier limits -->
                        <page string="Tier Limits" name="tier_limits">
                            <p class="text-muted" style="margin:0 0 10px;">
                                Turn on a toggle, then edit the value next to it. Only toggled columns are written.
                            </p>
                            <field name="line_ids" nolabel="1">
                                <tree editable="bottom" create="0" delete="0"
                                      decoration-success="apply_max_players or apply_base_point or apply_max_call"
                                      class="o_update_tier_lines">
                                    <field name="tier_id" string="Tier" readonly="1"/>
                                    <field name="apply_max_players"
                                           string="Max Players"
                                           widget="boolean_toggle"/>
                                    <field name="new_max_players"
                                           string="Value"
                                           attrs="{'readonly': [('apply_max_players', '=', False)]}"/>
                                    <field name="apply_base_point"
                                           string="Base Point"
                                           widget="boolean_toggle"/>
                                    <field name="new_base_point"
                                           string="Value"
                                           attrs="{'readonly': [('apply_base_point', '=', False)]}"/>
                                    <field name="apply_max_call"
                                           string="Max Call"
                                           widget="boolean_toggle"/>
                                    <field name="new_max_call"
                                           string="Value (0=none)"
                                           attrs="{'readonly': [('apply_max_call', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Tab 3: bid slabs -->
                        <page string="Bid Slabs" name="bid_slabs">
                            <group col="2">
                                <group>
                                    <field name="update_slabs"
                                           string="Replace bid slabs on all selected auctions"
                                           widget="boolean_toggle"/>
                                </group>
                            </group>
                            <p class="text-muted"
                               style="margin:0 0 10px;"
                               attrs="{'invisible': [('update_slabs', '=', False)]}">
                                Edit From / To / Increment below. Applying will
                                <strong>replace the full slab table</strong> on every selected auction.
                            </p>
                            <p class="text-muted"
                               style="margin:0 0 10px;"
                               attrs="{'invisible': [('update_slabs', '=', True)]}">
                                Turn on the toggle above to edit and apply bid slabs.
                            </p>
                            <field name="slab_ids" nolabel="1"
                                   attrs="{'readonly': [('update_slabs', '=', False)]}">
                                <tree editable="bottom">
                                    <field name="from_amount" string="From"/>
                                    <field name="to_amount" string="To"/>
                                    <field name="increment" string="Increment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                    <footer>
                        <button string="Apply Changes" type="object" name="button_apply"
                                class="btn-primary"
                                confirm="This will update the selected auctions (tier limits and/or bid slabs). Continue?"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>

                </form>
            </field>
        </record>

        <!-- Server action bound to the auction.auction list view -->
        <record id="action_update_tier_limits_server" model="ir.actions.server">
            <field name="name">Update Tier Limits &amp; Slabs</field>
            <field name="model_id" ref="auction_module.model_auction_auction"/>
            <field name="binding_model_id" ref="auction_module.model_auction_auction"/>
            <field name="binding_view_types">list</field>
            <field name="groups_id" eval="[(6, 0, [ref('auction_module.group_auction_group_admin')])]"/>
            <field name="state">code</field>
            <field name="code">action = env['auction.update.tier.limits'].with_context(active_ids=records.ids, active_model='auction.auction').action_open_wizard()</field>
        </record>

    </data>
</odoo>
