<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auction_player_card_wizard_form" model="ir.ui.view">
        <field name="name">auction.player.card.wizard.form</field>
        <field name="model">auction.player.card.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Player Cards">
                <field name="tournament_type" invisible="1"/>
                <div style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);
                            border-radius:12px;padding:1.15rem 1.4rem;margin-bottom:1.1rem;
                            border-left:4px solid #3b82f6;">
                    <h3 style="margin:0 0 .3rem;color:#fff;font-size:1.1rem;font-weight:700;">
                        Print Player Cards
                    </h3>
                    <p style="margin:0;color:rgba(255,255,255,.7);font-size:.85rem;line-height:1.5;">
                        Tick one or more statuses, then pick specific players. Download uses the
                        same player-card file as the player list print.
                    </p>
                </div>

                <group>
                    <group string="Include statuses">
                        <field name="tournament_id" readonly="1" force_save="1"/>
                        <field name="include_draft"/>
                        <field name="include_auction"/>
                        <field name="include_sold"/>
                        <field name="include_unsold"/>
                    </group>
                    <group string="Counts">
                        <field name="draft_count" string="Registered" readonly="1"/>
                        <field name="auction_count" string="In Auction" readonly="1"/>
                        <field name="sold_count" readonly="1"/>
                        <field name="unsold_count" readonly="1"/>
                        <field name="selected_count" string="Selected to print" readonly="1"/>
                        <field name="player_count" invisible="1"/>
                    </group>
                </group>

                <div style="display:flex;gap:8px;margin:0 0 .75rem;">
                    <button name="action_select_all" type="object" string="Select All" class="btn-secondary"/>
                    <button name="action_select_none" type="object" string="Unselect All" class="btn-secondary"/>
                </div>

                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0"
                          decoration-muted="print_ok == False">
                        <field name="print_ok" string="Print"/>
                        <field name="player_id" invisible="1"/>
                        <field name="player_photo" string="Photo" widget="image"
                               options="{'size': [48, 48]}"/>
                        <field name="player_sl_no" string="Sl No"/>
                        <field name="player_name" string="Name" readonly="1"/>
                        <field name="player_state" string="Status" readonly="1"/>
                        <field name="player_role" string="Role" readonly="1"
                               attrs="{'column_invisible': [('parent.tournament_type', '=', 'football')]}"/>
                    </tree>
                </field>

                <footer>
                    <button name="action_download" type="object" string="Download"
                            class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
