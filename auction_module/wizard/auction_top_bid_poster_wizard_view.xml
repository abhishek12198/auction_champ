<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auction_top_bid_poster_wizard_form" model="ir.ui.view">
        <field name="name">auction.top.bid.poster.wizard.form</field>
        <field name="model">auction.top.bid.poster.wizard</field>
        <field name="arch" type="xml">
            <form string="Top 5 Bid Posters">
                <div style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);
                            border-radius:12px;padding:1.15rem 1.4rem;margin-bottom:1.1rem;
                            border-left:4px solid #f0c14b;">
                    <h3 style="margin:0 0 .3rem;color:#fff;font-size:1.1rem;font-weight:700;">
                        Top 5 Bid Posters
                    </h3>
                    <p style="margin:0;color:rgba(255,255,255,.7);font-size:.85rem;line-height:1.5;">
                        Overall uses the tournament theme. Each tier uses that tier's colour.
                        Icon tiers are left out. One choice downloads an image. Several choices
                        download a zip.
                    </p>
                </div>
                <group>
                    <group string="Overall">
                        <field name="tournament_id" readonly="1" force_save="1"/>
                        <field name="include_overall" force_save="1"
                               attrs="{'readonly': [('overall_sold_count', '=', 0)]}"/>
                        <field name="overall_sold_count" readonly="1" force_save="1"/>
                    </group>
                </group>
                <div style="display:flex;gap:8px;margin:0 0 .75rem;">
                    <button name="action_select_tiers" type="object"
                            string="Select tiers with sales" class="btn-secondary"/>
                    <button name="action_clear_tiers" type="object"
                            string="Clear tiers" class="btn-secondary"/>
                </div>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0"
                          decoration-muted="available == False">
                        <field name="tier_id" readonly="1" force_save="1"/>
                        <field name="sold_count" readonly="1" force_save="1"/>
                        <field name="available" invisible="1" force_save="1"/>
                        <field name="selected" widget="boolean_toggle" force_save="1"
                               attrs="{'readonly': [('available', '=', False)]}"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_download" type="object" string="Download"
                            class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
