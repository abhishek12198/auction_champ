<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════════════════════
     Registration status card — 1080 × 1920.
     Left: night stadium, player photo, tournament logo, team mark.
     Right: Player / Registered in the tournament theme, then that
     tournament's own attribute rows.
     ══════════════════════════════════════════════════════════════════════ -->
<template id="player_card_portrait_image" name="Player Card Instagram Status Image">
<html>
<head>
    <meta charset="utf-8"/>
    <style><t t-out="css"/></style>
</head>
<body>
<div class="pc">
    <div class="pc-left">
        <div class="pc-stadium" t-attf-style="background-image:url({{ stadium_uri }});"/>
        <t t-if="photo_uri">
            <div class="pc-photo" t-attf-style="background-image:url({{ photo_uri }});"/>
        </t>
    </div>
    <div class="pc-right">
        <t t-if="poster_wash_uri">
            <div class="pc-wash" t-attf-style="background-image:url({{ poster_wash_uri }});"/>
        </t>
        <div class="pc-brand">
            <t t-if="tournament_logo_uri">
                <div class="pc-brand-mark">
                    <div class="pc-logo" t-attf-style="background-image:url({{ tournament_logo_uri }});"/>
                </div>
            </t>
            <div class="pc-brand-copy">
                <div class="pc-tname"><t t-out="tournament.name if tournament else brand_name"/></div>
                <t t-if="season_line">
                    <div class="pc-season"><t t-out="season_line"/></div>
                </t>
                <t t-if="date_line or venue_line">
                    <div class="pc-facts">
                        <t t-if="date_line">
                            <div class="pc-fact"><t t-out="date_line"/></div>
                        </t>
                        <t t-if="venue_line">
                            <div class="pc-fact"><t t-out="venue_line"/></div>
                        </t>
                    </div>
                </t>
            </div>
        </div>
        <div class="pc-player-word">PLAYER</div>
        <div class="pc-reg-word"><t t-out="status_word"/></div>
        <div class="pc-namebar">
            <t t-if="name_first">
                <span class="pc-nf" t-attf-style="font-size:{{ name_px }}px;"><t t-out="name_first"/></span>
                <span class="pc-nl" t-attf-style="font-size:{{ name_px }}px;"><t t-out="name_last"/></span>
            </t>
            <t t-else="">
                <span class="pc-nf" t-attf-style="font-size:{{ name_px }}px;"><t t-out="name_last"/></span>
            </t>
        </div>
        <div class="pc-rows">
            <t t-foreach="rows" t-as="row">
                <div class="pc-row">
                    <div class="pc-ico"><div class="pc-ico-box"><t t-out="icons[row['icon']]"/></div></div>
                    <div class="pc-meta">
                        <div class="pc-lbl"><t t-out="row['label']"/></div>
                        <div class="pc-val"><t t-out="row['value']"/></div>
                    </div>
                </div>
            </t>
        </div>
        <t t-if="is_sold and (team_name or sold_points_label)">
            <div class="pc-sold">
                <div class="pc-sold-row">
                    <t t-if="team_logo_uri">
                        <div class="pc-sold-mark">
                            <div class="pc-sold-logo" t-attf-style="background-image:url({{ team_logo_uri }});"/>
                        </div>
                    </t>
                    <div class="pc-sold-copy">
                        <t t-if="team_name">
                            <div class="pc-sold-team"><t t-out="team_name"/></div>
                        </t>
                        <t t-if="sold_points_label">
                            <div class="pc-sold-pts"><t t-out="sold_points_label"/></div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
        <div class="pc-powered">
            <div class="pc-edition"><t t-if="edition_line"><t t-out="edition_line"/></t></div>
            <div class="pc-powered-label">POWERED BY</div>
            <t t-if="brand_logo_uri">
                <div class="pc-ac-logo" t-attf-style="background-image:url({{ brand_logo_uri }});"/>
            </t>
        </div>
    </div>
</div>
</body>
</html>
</template>

</odoo>
