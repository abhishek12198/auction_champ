<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════════════════════
     AUCTIONCHAMP INSTAGRAM STATUS CARD  —  1080 × 1920 px (9:16)
     Full-bleed Stories / Status format for cricket / football ZIP export.
     Rendered to JPG by wkhtmltoimage.  Qt-WebKit safe.
     Context from auction.team.player._card_values():
      player, tournament, team, is_football, css, icons,
      photo_uri, team_logo_uri, tournament_logo_uri, stadium_uri,
      brand_name, name_first, name_last, card_id, badge, rows (6),
      row_pairs, status_color, status_text, show_status
     ══════════════════════════════════════════════════════════════════════ -->
<template id="player_card_portrait_image" name="Player Card Instagram Status Image">
<html>
<head>
    <meta charset="utf-8"/>
    <style><t t-out="css"/></style>
</head>
<body>
<div class="pc">

    <!-- Stadium background (cricket / football) -->
    <div class="pc-bg" t-attf-style="background-image:url({{ stadium_uri }});"/>
    <div class="pc-shade"/>
    <div class="pc-glow"/>

    <!-- Frame -->
    <div class="pc-frame"/>
    <div class="pc-frame-in"/>

    <!-- Header: brand logo · tournament · player id -->
    <div class="pc-head">
        <div class="pc-hcell pc-brand">
            <!-- Prefer tournament logo in header; team logo appears in the sold stamp -->
            <t t-if="tournament_logo_uri">
                <div class="pc-brand-logo" t-attf-style="background-image:url({{ tournament_logo_uri }});"/>
            </t>
            <t t-elif="team_logo_uri">
                <div class="pc-brand-logo" t-attf-style="background-image:url({{ team_logo_uri }});"/>
            </t>
            <t t-else="">
                <div class="pc-brand-ph">AC</div>
            </t>
            <div class="pc-brand-name">
                <t t-out="tournament.name if tournament else brand_name"/>
            </div>
        </div>
        <div class="pc-hcell pc-hmid">
            <div class="pc-tname">
                <t t-out="tournament.name if tournament else 'AuctionChamp'"/>
            </div>
        </div>
        <div class="pc-hcell pc-hid">
            <div class="pc-pid-lbl">PLAYER ID</div>
            <div class="pc-pid-val"><t t-out="card_id"/></div>
        </div>
    </div>

    <!-- Player hero -->
    <div class="pc-stage">
        <t t-if="show_status">
            <div class="pc-status" t-attf-style="background:{{ status_color }};">
                <t t-out="status_text"/>
            </div>
        </t>

        <t t-if="photo_uri">
            <div class="pc-photo-wrap">
                <img class="pc-photo-img" t-att-src="photo_uri" alt=""/>
            </div>
        </t>
        <t t-else="">
            <div class="pc-photo-ph">&#9787;</div>
        </t>

        <!-- Sold / Unsold rubber stamp (translucent, over photo) -->
        <t t-if="show_stamp">
            <div t-attf-class="pc-stamp {{ 'unsold' if stamp_is_unsold else '' }}">
                <div class="pc-stamp-ring"/>
                <div class="pc-stamp-body">
                    <div class="pc-stamp-inner">
                        <div class="pc-stamp-tag"><t t-out="stamp_title"/></div>
                        <t t-if="not stamp_is_unsold">
                            <t t-if="team_logo_uri">
                                <div class="pc-stamp-logo" t-attf-style="background-image:url({{ team_logo_uri }});"/>
                            </t>
                            <t t-else="">
                                <div class="pc-stamp-logo-ph">★</div>
                            </t>
                            <div class="pc-stamp-amt"><t t-out="stamp_amount"/></div>
                            <t t-if="stamp_sub">
                                <div class="pc-stamp-sub"><t t-out="stamp_sub"/></div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="pc-stamp-logo-ph">✕</div>
                        </t>
                    </div>
                </div>
            </div>
        </t>

        <div class="pc-pname">
            <t t-if="name_first">
                <div class="pc-pfn"><t t-out="name_first"/></div>
            </t>
            <div class="pc-pln"><t t-out="name_last"/></div>
            <div class="pc-role"><t t-out="badge"/></div>
        </div>
    </div>

    <!-- 3×2 info panel -->
    <div class="pc-panel-wrap">
        <div class="pc-panel">
            <table>
                <t t-foreach="row_pairs" t-as="pair">
                    <tr>
                        <t t-foreach="pair" t-as="r">
                            <td>
                                <div class="pc-cell">
                                    <div class="pc-ic">
                                        <t t-if="r['icon'] == 'team' and team_logo_uri">
                                            <div class="pc-ilogo" t-attf-style="background-image:url({{ team_logo_uri }});"/>
                                        </t>
                                        <t t-else="">
                                            <div class="pc-ibox">
                                                <t t-out="icons.get(r['icon'], icons.get('category', ''))"/>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="pc-itxt">
                                        <div class="pc-lbl"><t t-out="r['label']"/></div>
                                        <div class="pc-val"><t t-out="r['value']"/></div>
                                    </div>
                                </div>
                            </td>
                        </t>
                    </tr>
                </t>
            </table>
        </div>
    </div>

</div>
</body>
</html>
</template>

</odoo>
