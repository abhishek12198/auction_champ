<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════════════════
     PREMIUM PORTRAIT PLAYER CARD  (1080 x 1350, IPL broadcast style)
     Rendered to a PNG by wkhtmltoimage for the bulk ZIP export.
     Standalone HTML document. Qt-WebKit safe (no CSS grid / var / object-fit).
     Context is built by auction.team.player._card_values():
       player, tournament, team, is_football, pal, css, icons,
       photo_uri, team_logo_uri, tournament_logo_uri,
       name_first, name_last, card_id, badge, rows
     ══════════════════════════════════════════════════════════════════ -->
<template id="player_card_portrait_image" name="Player Card Portrait Image">
<html>
<head>
    <meta charset="utf-8"/>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Oswald:wght@400;500;600;700&amp;family=Barlow:wght@400;500;600;700&amp;family=Rajdhani:wght@600;700&amp;display=swap" rel="stylesheet"/>
    <style><t t-raw="css"/></style>
</head>
<body>
    <div class="pc">

        <div class="pc-acc tl"/>
        <div class="pc-acc br"/>
        <div class="pc-acc br2"/>

        <!-- Header -->
        <div class="pc-head">
            <div class="pc-cell" style="width:104px;">
                <t t-if="team_logo_uri">
                    <div class="pc-badge" t-attf-style="background-image:url({{ team_logo_uri }});"/>
                </t>
                <t t-elif="tournament_logo_uri">
                    <div class="pc-badge" t-attf-style="background-image:url({{ tournament_logo_uri }});"/>
                </t>
                <t t-else="">
                    <div class="pc-badge">&#9733;</div>
                </t>
            </div>
            <div class="pc-cell pc-mid">
                <div class="pc-team"><t t-out="(team.name if team else (tournament.name if tournament else 'Auction'))"/></div>
                <div class="pc-tour"><t t-out="(tournament.name if (team and tournament) else 'Player Card')"/></div>
            </div>
            <div class="pc-cell pc-id">
                <small>Player ID</small>
                <b><t t-out="card_id"/></b>
            </div>
        </div>

        <!-- Photo + name -->
        <div class="pc-stage">
            <t t-if="photo_uri">
                <div class="pc-photo" t-attf-style="background-image:url({{ photo_uri }});"/>
            </t>
            <t t-else="">
                <div class="pc-photo-ph">&#9787;</div>
            </t>
            <div class="pc-fade"/>
            <div class="pc-name">
                <t t-if="name_first"><div class="pc-fn"><t t-out="name_first"/></div></t>
                <div class="pc-ln"><t t-out="name_last"/></div>
                <div class="pc-pill"><t t-out="badge"/></div>
            </div>
        </div>

        <!-- Details grid -->
        <div class="pc-grid">
            <t t-foreach="rows" t-as="r">
                <div t-attf-class="pc-tile {{ 'nomr' if r['nomr'] else '' }}">
                    <div class="pc-tin">
                        <div class="pc-ic">
                            <t t-if="r['icon'] == 'team' and team_logo_uri">
                                <div class="pc-ilogo" t-attf-style="background-image:url({{ team_logo_uri }});"/>
                            </t>
                            <t t-else="">
                                <div class="pc-ibox"><t t-raw="icons.get(r['icon'], '')"/></div>
                            </t>
                        </div>
                        <div class="pc-txt">
                            <div class="pc-lbl"><t t-out="r['label']"/></div>
                            <div class="pc-val"><t t-out="r['value']"/></div>
                        </div>
                    </div>
                </div>
            </t>
        </div>

        <!-- Footer -->
        <div class="pc-foot">
            <span class="ln"/>
            <div class="pc-brand">AUCTION<b>CHAMP</b></div>
            <div class="pc-fsub"><t t-out="(tournament.name if tournament else '')"/></div>
            <t t-if="tournament and (tournament.tournament_date or tournament.venue)">
            <div class="pc-fsub" style="margin-top:3px; font-size:0.65em; opacity:0.75; letter-spacing:1.5px;">
                <t t-if="tournament.tournament_date"><t t-out="tournament.tournament_date.strftime('%d %b %Y')"/></t><t t-if="tournament.tournament_date and tournament.venue"> · </t><t t-if="tournament.venue"><t t-out="tournament.venue"/></t>
            </div>
            </t>
        </div>

    </div>
</body>
</html>
</template>

</odoo>
