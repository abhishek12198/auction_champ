<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="squad_poster_template" name="Squad Poster Franchise Reveal">
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Squad Poster — <t t-esc="team_name"/> | AuctionChamp</title>
  <t t-set="sp_favicon" t-value="('/web/image/res.company/%d/favicon' % res_company.id) if (res_company and res_company.favicon) else '/auction_module/static/img/logo.svg'"/>
  <link rel="shortcut icon" t-att-href="sp_favicon"/>
  <link rel="icon" t-att-href="sp_favicon"/>
  <link rel="apple-touch-icon" t-att-href="sp_favicon"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
  <link href="https://fonts.googleapis.com/css2?family=Black+Ops+One&amp;family=Oswald:wght@600;700&amp;family=Roboto+Condensed:ital,wght@0,700;1,700&amp;family=Russo+One&amp;family=Teko:wght@600;700&amp;display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/auction_module/static/src/css/squad_poster.css?v=280"/>
</head>
<body class="sp-shell" t-att-data-palette="palette" t-att-data-team-name="team_name" t-att-data-tournament-name="tournament_name" id="spShell">

  <div class="sp-toolbar" id="spToolbar">
    <div class="sp-toolbar-title">Squad Poster · Save &amp; Share</div>
    <div class="sp-toolbar-actions">
      <button type="button" class="sp-btn is-primary" id="spDlPng" data-fmt="png">Save PNG</button>
      <button type="button" class="sp-btn is-primary" id="spDlJpg" data-fmt="jpg">Save JPG</button>
      <button type="button" class="sp-btn" id="spShare" style="display:none;">Share</button>
      <button type="button" class="sp-btn sp-btn-desktop" id="spPrint">Print</button>
      <button type="button" class="sp-btn is-primary" id="spEditPhotos">Adjust photos</button>
    </div>
    <div class="sp-player-edit-bar" id="spPlayerEditBar"></div>
    <!-- Docked editor (NOT full-screen — full-screen overlay was eating all clicks) -->
    <div class="sp-peditor sp-peditor--dock" id="spPhotoEditor" aria-hidden="true" style="display:none;pointer-events:none;">
      <div class="sp-peditor-panel" role="dialog" aria-labelledby="spPeditorTitle">
        <div class="sp-peditor-head">
          <h2 class="sp-peditor-title" id="spPeditorTitle">Adjust photo</h2>
          <button type="button" class="sp-btn sp-peditor-x" id="spPeditorClose" aria-label="Close">X</button>
        </div>
        <p class="sp-peditor-help">Drag to move · Zoom to scale · Done applies to the poster</p>
        <div class="sp-peditor-stage" id="spPeditorStage">
          <img class="sp-peditor-img" id="spPeditorImg" alt="" draggable="false"/>
        </div>
        <div class="sp-peditor-controls">
          <button type="button" class="sp-btn" id="spPeditorZoomOut" aria-label="Zoom out">-</button>
          <input type="range" class="sp-peditor-range" id="spPeditorZoom" min="100" max="320" value="100" step="2"/>
          <button type="button" class="sp-btn" id="spPeditorZoomIn" aria-label="Zoom in">+</button>
          <span class="sp-peditor-zoom-lbl" id="spPeditorZoomLbl">100%</span>
        </div>
        <div class="sp-peditor-actions">
          <button type="button" class="sp-btn" id="spPeditorReset">Reset</button>
          <button type="button" class="sp-btn is-primary" id="spPeditorDone">Done</button>
        </div>
      </div>
    </div>
    <div class="sp-toolbar-opts">
      <div class="sp-zoom-group">
        <label class="sp-footer-txt" for="spZoom">Zoom</label>
        <select class="sp-select" id="spZoom">
          <option value="auto" selected="selected">Fit</option>
          <option value="0.25">25%</option>
          <option value="0.35">35%</option>
          <option value="0.45">45%</option>
          <option value="0.55">55%</option>
          <option value="0.7">70%</option>
          <option value="1">100%</option>
        </select>
      </div>
      <div class="sp-zoom-group sp-btn-desktop">
        <label class="sp-footer-txt" for="spScale">Quality</label>
        <select class="sp-select" id="spScale">
          <option value="1" selected="selected">1× (phone-friendly)</option>
          <option value="2">2× (high-res)</option>
          <option value="3">3× (max)</option>
        </select>
      </div>
    </div>
    <div class="sp-status" id="spStatus"></div>
    <div class="sp-hint">1) Tap Edit on a player · 2) Drag / zoom · 3) Done · 4) Save PNG/JPG</div>
    <div class="sp-palette-row sp-btn-desktop" id="spPaletteRow">
      <span class="sp-palette-lbl">Palette</span>
      <button type="button" class="sp-swatch" data-palette="ember-orange" title="Ember"></button>
      <button type="button" class="sp-swatch" data-palette="pace-lime" title="Pace Lime"></button>
      <button type="button" class="sp-swatch" data-palette="midnight-gold" title="Midnight Gold"></button>
      <button type="button" class="sp-swatch" data-palette="arctic-cyan" title="Arctic Cyan"></button>
      <button type="button" class="sp-swatch" data-palette="royal-violet" title="Royal Violet"></button>
      <button type="button" class="sp-swatch" data-palette="carbon-chrome" title="Carbon"></button>
      <button type="button" class="sp-swatch" data-palette="crimson-flare" title="Crimson"></button>
    </div>
  </div>

  <div class="sp-preview-wrap">
    <div class="sp-preview-scale" id="spScaleBox">
      <div class="sp-canvas" id="spCanvas">

        <div class="sp-bg" aria-hidden="true">
          <t t-if="bg_uri">
            <img class="sp-bg-tourn" t-att-src="bg_uri" alt=""/>
            <div class="sp-bg-scrim"></div>
            <div class="sp-bg-vignette"></div>
          </t>
          <t t-else="">
            <img class="sp-bg-img" src="/auction_module/static/src/assets/images/squad_poster/sp_bg_stadium.jpg" alt=""/>
            <div class="sp-bg-grade"></div>
            <img class="sp-fx-smoke" src="/auction_module/static/src/assets/images/squad_poster/sp_smoke.jpg" alt=""/>
            <img class="sp-fx-fire" src="/auction_module/static/src/assets/images/squad_poster/sp_fire_band.jpg" alt=""/>
            <img class="sp-fx-sparks" src="/auction_module/static/src/assets/images/squad_poster/sp_sparks.jpg" alt=""/>
            <div class="sp-fx-flare"></div>
            <div class="sp-bg-vignette"></div>
          </t>
        </div>

        <div class="sp-layer">

          <header class="sp-header">
            <div class="sp-header-row">
              <div class="sp-header-left">
                <div class="sp-tourn-logo-wrap">
                  <t t-if="tourn_logo_uri">
                    <img class="sp-tourn-logo" t-att-src="tourn_logo_uri" alt=""/>
                  </t>
                  <t t-else="">
                    <div class="sp-tourn-logo-ph">AC</div>
                  </t>
                </div>
              </div>
              <div class="sp-tourn-titles">
                <div class="sp-type sp-type--gold sp-type--single" id="spTournTitle">
                  <span class="sp-type-depth" t-esc="tournament_name"/>
                  <span class="sp-type-glow" t-esc="tournament_name"/>
                  <span class="sp-type-face" t-esc="tournament_name"/>
                </div>
                <div class="sp-season-row">
                  <span class="sp-season-rule"></span>
                  <span class="sp-season" t-esc="season_label or 'SEASON'"/>
                  <span class="sp-season-rule"></span>
                </div>
                <t t-if="date_label or venue">
                  <div class="sp-meta-row">
                    <t t-if="date_label">
                      <span class="sp-meta-item" t-esc="date_label"/>
                    </t>
                    <t t-if="date_label and venue">
                      <span class="sp-meta-sep" aria-hidden="true"></span>
                    </t>
                    <t t-if="venue">
                      <span class="sp-meta-item" t-esc="venue"/>
                    </t>
                  </div>
                </t>
              </div>
              <div class="sp-header-right" aria-hidden="true"></div>
            </div>
          </header>

          <section class="sp-team">
            <div class="sp-team-left">
              <h1 class="sp-team-name"
                  t-att-style="'--sp-tn1:%spx;--sp-tn2:%spx;--sp-tn0:%spx;' % (team_type_line1 or 52, team_type_body or 44, team_type_only or 48)">
                <t t-foreach="team_name_lines" t-as="line">
                  <span class="sp-team-word">
                    <span class="sp-team-word-depth" t-esc="line"/>
                    <span class="sp-team-word-face" t-esc="line"/>
                  </span>
                </t>
              </h1>
            </div>
            <div class="sp-team-mid">
              <div class="sp-team-logo-wrap">
                <t t-if="team_logo_uri">
                  <img class="sp-team-logo" t-att-src="team_logo_uri" alt=""/>
                </t>
                <t t-else="">
                  <div class="sp-team-logo-ph" t-esc="(team_name or 'T')[:1]"/>
                </t>
              </div>
            </div>
            <div class="sp-team-right">
              <div class="sp-manager-lbl">TEAM MANAGER</div>
              <div class="sp-manager-name" t-esc="manager or '—'"/>
            </div>
          </section>

          <section class="sp-squad" t-att-data-has-icon="'1' if has_icon else '0'">
            <t t-if="not has_icon">
              <div class="sp-slogan" aria-hidden="true">
                <img class="sp-slogan-logo" src="/auction_module/static/img/logo.svg" alt=""/>
                <div class="sp-slogan-words">
                  <span class="sp-slogan-word">BID</span>
                  <span class="sp-slogan-dot">·</span>
                  <span class="sp-slogan-word">BUILD</span>
                  <span class="sp-slogan-dot">·</span>
                  <span class="sp-slogan-word">DOMINATE</span>
                </div>
              </div>
            </t>
            <t t-if="has_icon and icon_players and not (grouped and groups)">
              <!-- Icon / Key players — 1 centered, 2–4 distributed equally -->
              <div class="sp-icon-hero-row"
                   t-att-data-count="str(icon_count or len(icon_players))"
                   t-att-style="'--sp-icon-count:%s' % (icon_count or len(icon_players) or 1)">
                <t t-foreach="icon_players" t-as="icon_pl">
                  <t t-call="auction_module.squad_poster_card">
                    <t t-set="pl" t-value="icon_pl"/>
                  </t>
                </t>
              </div>
              <t t-if="player_rows">
                <div class="sp-grid-sym"
                     t-att-data-rows="str(grid_rows or 1)"
                     t-att-style="'--sp-cols:%s;--sp-rows:%s;--sp-row-gap:%spx;' % (grid_cols or 5, grid_rows or 1, row_gap or 4)">
                  <t t-foreach="player_rows or []" t-as="row">
                    <div class="sp-grid-row">
                      <t t-foreach="row" t-as="card_pl">
                        <t t-call="auction_module.squad_poster_card">
                          <t t-set="pl" t-value="card_pl"/>
                        </t>
                      </t>
                    </div>
                  </t>
                </div>
              </t>
            </t>
            <t t-elif="grouped and groups">
              <t t-foreach="groups" t-as="grp">
                <div class="sp-cat">
                  <div class="sp-cat-bar" t-esc="grp['label']"/>
                  <div class="sp-grid-sym"
                       t-att-style="'--sp-cols:%s' % (grid_cols or 5)"
                       t-att-data-sparse="'1' if sparse_squad else '0'">
                    <t t-foreach="grp['players']" t-as="card_pl">
                      <t t-call="auction_module.squad_poster_card">
                        <t t-set="pl" t-value="card_pl"/>
                      </t>
                    </t>
                  </div>
                </div>
              </t>
            </t>
            <t t-else="">
              <div class="sp-grid-sym"
                   t-att-data-rows="str(grid_rows or 1)"
                   t-att-style="'--sp-cols:%s;--sp-rows:%s;--sp-row-gap:%spx;' % (grid_cols or 5, grid_rows or 1, row_gap or 4)">
                <t t-foreach="player_rows or []" t-as="row">
                  <div class="sp-grid-row">
                    <t t-foreach="row" t-as="card_pl">
                      <t t-call="auction_module.squad_poster_card">
                        <t t-set="pl" t-value="card_pl"/>
                      </t>
                    </t>
                  </div>
                </t>
              </div>
            </t>
          </section>

          <t t-if="strike_force and strike_force.get('items')">
            <section class="sp-strike">
              <div class="sp-strike-rule"></div>
              <div class="sp-strike-title" t-esc="strike_force.get('title') or 'THE STRIKE FORCE'"/>
              <div class="sp-strike-tag" t-esc="strike_force.get('tagline') or 'ONE TEAM • ONE MISSION • ONE TROPHY'"/>
              <div class="sp-strike-stats">
                <t t-foreach="strike_force.get('items') or []" t-as="st">
                  <div class="sp-strike-stat">
                    <div class="sp-strike-num" t-esc="st.get('value') or '00'"/>
                    <div class="sp-strike-lbl" t-esc="st.get('label') or ''"/>
                  </div>
                </t>
              </div>
              <div class="sp-strike-rule"></div>
            </section>
          </t>

          <t t-if="has_sponsors">
            <div class="sp-sponsors-block">
              <div class="sp-sponsors-lbl-row">
                <span class="sp-sponsors-rule"></span>
                <span class="sp-sponsors-lbl">SPONSORS</span>
                <span class="sp-sponsors-rule"></span>
              </div>
              <div class="sp-sponsors-row" t-att-data-count="str(len(sponsors or []))">
                <t t-foreach="sponsors" t-as="sp">
                  <div class="sp-sponsor">
                    <img t-att-src="sp.get('uri')" t-att-alt="sp.get('name') or 'Sponsor'"/>
                  </div>
                </t>
              </div>
            </div>
          </t>

          <footer class="sp-footer">
            <div class="sp-hashtag" t-esc="hashtag"/>
            <div class="sp-brand">
              <img class="sp-brand-logo" src="/auction_module/static/img/logo.svg" alt="AuctionChamp" onerror="this.style.display='none'"/>
              <span class="sp-brand-url" t-esc="brand_url"/>
            </div>
          </footer>

        </div>
      </div>
    </div>
  </div>

  <script src="/auction_module/static/src/lib/html2canvas.min.js"></script>
  <script src="/auction_module/static/src/js/squad_poster_page.js?v=282"></script>
  <script>
    window.addEventListener('load', function () {
      if (!window.spEditPlayer) {
        var s = document.getElementById('spStatus');
        if (s) {
          s.textContent = 'Editor script missing — upgrade auction_module (1.5.383) and hard-refresh';
          s.className = 'sp-status is-err';
        }
      }
    });
  </script>
</body>
</html>
</template>
<template id="squad_poster_card" name="Squad Poster Card">
  <article t-attf-class="sp-card#{' is-icon' if pl.get('is_icon') else ''}"
           t-att-data-player-id="pl.get('id')"
           t-att-data-player-name="pl.get('name') or 'Player'"
           t-att-data-photo-crop="pl.get('photo_uri')"
           t-att-data-icon-badge="pl.get('icon_badge') or 'ICON PLAYER'">
    <div class="sp-card-frame">
      <img class="sp-card-lava" src="/auction_module/static/src/assets/images/squad_poster/sp_icon_fire.jpg" alt=""/>
      <t t-if="pl.get('is_icon')">
        <div class="sp-card-spotlight" aria-hidden="true"></div>
        <div class="sp-card-icon-badge">
          <span class="sp-card-icon-badge-ico" aria-hidden="true">👑</span>
          <span class="sp-card-icon-badge-txt" t-esc="pl.get('icon_badge') or 'ICON PLAYER'"/>
        </div>
      </t>
      <t t-if="pl.get('photo_uri')">
        <div class="sp-card-photo-wrap">
          <img class="sp-card-photo" t-att-src="pl.get('photo_uri')" t-att-alt="pl.get('name') or 'Player'" draggable="false"/>
        </div>
      </t>
      <t t-else="">
        <div class="sp-card-photo-ph" t-esc="pl.get('initials') or '?'"/>
      </t>
      <div class="sp-card-meta">
        <t t-if="pl.get('is_icon')">
          <div class="sp-card-name-row">
            <span class="sp-card-name-emblem" aria-hidden="true">★</span>
            <div class="sp-card-name" t-esc="pl.get('name')"/>
            <span class="sp-card-name-emblem" aria-hidden="true">★</span>
          </div>
        </t>
        <t t-else="">
          <div class="sp-card-name" t-esc="pl.get('name')"/>
        </t>
        <div class="sp-card-role" t-esc="pl.get('role') or 'Player'"/>
      </div>
    </div>
  </article>
</template>
</odoo>
