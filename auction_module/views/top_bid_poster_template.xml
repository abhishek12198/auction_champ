<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="top_bid_poster" name="Top Bid Poster">
<html>
<head>
<meta charset="utf-8"/>
<style>
  html, body { width: 1080px; height: 1350px; margin: 0; padding: 0; background: #07111f; }
  * { box-sizing: border-box; }
</style>
</head>
<body>
<div style="width:1080px;height:1350px;overflow:hidden;background:#07111f;color:#f7f4ea;font-family:Arial,Helvetica,sans-serif;">
  <div t-attf-style="height:10px;background:{{ rank_color }};"></div>
  <table style="width:100%;border-collapse:collapse;height:168px;">
    <tr>
      <td style="width:150px;padding:28px 0 12px 40px;vertical-align:middle;">
        <t t-if="tournament_logo_uri">
          <img t-att-src="tournament_logo_uri" alt="" style="width:108px;height:108px;border-radius:16px;background:#fff;"/>
        </t>
        <t t-else="">
          <div t-attf-style="width:108px;height:108px;border-radius:16px;background:{{ rank_color }};color:#111;font-size:36px;font-weight:bold;text-align:center;line-height:108px;">
            <t t-esc="tournament_initials"/>
          </div>
        </t>
      </td>
      <td style="vertical-align:middle;padding:28px 16px 12px 8px;">
        <div style="font-size:18px;letter-spacing:5px;color:#e8b923;font-weight:bold;">TOP BIDS</div>
        <div style="font-size:42px;font-weight:bold;line-height:1.05;letter-spacing:0.5px;text-transform:uppercase;">
          <t t-esc="tournament_name"/>
        </div>
      </td>
      <td style="width:180px;vertical-align:middle;text-align:right;padding:28px 40px 12px 0;">
        <div t-attf-style="display:inline-block;min-width:92px;background:{{ rank_color }};color:{{ rank_ink }};font-size:48px;font-weight:bold;text-align:center;padding:8px 16px;border-radius:12px;">
          #<t t-esc="rank"/>
        </div>
      </td>
    </tr>
  </table>

  <div style="padding:8px 40px 0;">
    <t t-if="photo_uri">
      <img t-att-src="photo_uri" alt="" style="width:1000px;height:640px;border-radius:18px;"/>
    </t>
    <t t-else="">
      <div style="width:1000px;height:640px;border-radius:18px;background:#152033;color:#d7deea;font-size:180px;font-weight:bold;text-align:center;line-height:640px;">
        <t t-esc="player_initials"/>
      </div>
    </t>
  </div>

  <div style="padding:26px 48px 0;font-size:58px;font-weight:bold;line-height:1.05;letter-spacing:0.5px;text-transform:uppercase;">
    <t t-esc="player_name"/>
  </div>

  <table style="width:100%;border-collapse:collapse;margin-top:22px;">
    <tr>
      <td style="vertical-align:middle;padding:0 20px 0 48px;">
        <div style="font-size:16px;letter-spacing:4px;color:#e8b923;font-weight:bold;">SOLD FOR</div>
        <div style="font-size:54px;font-weight:bold;line-height:1.05;margin-top:4px;">
          <t t-esc="points_display"/>
        </div>
      </td>
      <td style="width:460px;vertical-align:middle;padding:0 48px 0 12px;">
        <table style="width:100%;border-collapse:collapse;background:#101a2c;border-radius:16px;">
          <tr>
            <td style="width:108px;padding:14px 8px 14px 16px;vertical-align:middle;">
              <t t-if="team_logo_uri">
                <img t-att-src="team_logo_uri" alt="" style="width:78px;height:78px;border-radius:12px;background:#fff;"/>
              </t>
              <t t-else="">
                <div t-attf-style="width:78px;height:78px;border-radius:12px;background:{{ rank_color }};color:#111;font-size:26px;font-weight:bold;text-align:center;line-height:78px;">
                  <t t-esc="team_initials"/>
                </div>
              </t>
            </td>
            <td style="vertical-align:middle;padding:14px 16px 14px 4px;">
              <div style="font-size:14px;letter-spacing:3px;color:#e8b923;font-weight:bold;">SOLD TO</div>
              <div style="font-size:28px;font-weight:bold;line-height:1.1;text-transform:uppercase;margin-top:4px;">
                <t t-esc="team_name"/>
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <div style="padding:28px 48px 0;font-size:14px;letter-spacing:3px;color:#8b97a8;">
    <t t-esc="rank_label"/>
  </div>
</div>
</body>
</html>
</template>
</odoo>
