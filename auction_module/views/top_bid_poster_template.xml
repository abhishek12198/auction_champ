<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="top_bid_poster" name="Top Bid Poster">
<html>
<head>
<meta charset="utf-8"/>
<style>
  <t t-raw="font_css"/>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-print-color-adjust: exact; }
  html, body { width: 1920px; height: 1080px; margin: 0; padding: 0; overflow: hidden; background: #06101f; }
  .sheet { position: relative; width: 1920px; height: 1080px; overflow: hidden; color: #fff; font-family: 'TBLabel', 'Montserrat', Arial, sans-serif; }
  .bg { position: absolute; top: 0; left: 0; width: 1920px; height: 1080px; }
  .veil {
    position: absolute; top: 0; left: 0; width: 1920px; height: 1080px;
    background-image: -webkit-linear-gradient(top, rgba(4,12,32,.18) 0%, rgba(4,12,32,.42) 22%, rgba(3,8,22,.78) 48%, rgba(3,8,20,.94) 100%);
  }
  .brand { position: absolute; top: 26px; left: 44px; z-index: 6; }
  .brand-logo { width: 248px; height: 38px; display: block; }
  .tmark {
    position: absolute; top: 14px; right: 44px; z-index: 6;
    width: 96px; height: 96px; border-radius: 48px;
    border: 2px solid #e8c25a; background: #0c1424; overflow: hidden;
  }
  .tmark img { display: block; width: 96px; height: 96px; }
  .tmark-ph {
    width: 96px; height: 96px;
    font-family: 'TBTeko', Impact, sans-serif;
    font-size: 36px; line-height: 92px; text-align: center; color: #fff;
  }
  .mast { position: absolute; top: 10px; left: 310px; width: 1240px; text-align: center; z-index: 4; }
  .tourn {
    font-family: 'TBName', 'Oswald', sans-serif;
    color: #fff; line-height: 1; letter-spacing: 0.5px;
    white-space: nowrap; overflow: hidden;
    text-shadow: 0 3px 12px rgba(0,0,0,.5);
  }
  .tdesc {
    width: 980px; margin: 6px auto 0;
    font-family: 'TBLabel', 'Montserrat', sans-serif;
    color: #d7e2f2; letter-spacing: 0.4px; line-height: 1.25;
    max-height: 48px; overflow: hidden;
  }
  .top5 {
    margin-top: 2px;
    font-family: 'TBTeko', Impact, sans-serif;
    font-size: 76px; line-height: 0.78; letter-spacing: 1px; color: #ffe08a;
    text-shadow: 0 2px 0 #fff6cf, 0 4px 0 #e2b034, 0 7px 0 #a87812, 0 10px 16px rgba(0,0,0,.4);
  }
  .bids {
    margin-top: -4px;
    font-family: 'TBDisplay', Impact, sans-serif;
    font-size: 50px; line-height: 0.9; letter-spacing: 6px; color: #f5f8fd;
    text-shadow: 0 2px 0 #ffffff, 0 4px 0 #c5d0e0, 0 8px 14px rgba(0,0,0,.4);
  }
  .card {
    position: absolute; top: 262px; width: 340px; height: 786px;
    border: 2px solid #e8c25a;
    border-radius: 18px;
    overflow: hidden;
    background: #0b1220;
    box-shadow: 0 0 0 1px rgba(255,214,120,.25), 0 0 22px rgba(232,185,50,.28), 0 16px 28px rgba(0,0,0,.45);
  }
  .photo { position: absolute; top: 0; left: 0; width: 340px; height: 430px; background: #10192c; }
  .photo img { display: block; width: 340px; height: 430px; }
  .ph {
    width: 340px; height: 430px;
    font-family: 'TBTeko', Impact, sans-serif;
    font-size: 92px; line-height: 430px; text-align: center; color: rgba(255,255,255,.35);
    background-image: -webkit-linear-gradient(135deg, #16315f 0%, #0c1424 100%);
  }
  .wash { position: absolute; left: 0; top: 0; width: 340px; height: 430px; }
  .badge {
    position: absolute; top: 14px; left: 14px; width: 64px; height: 64px;
    border-radius: 14px; border: 2px solid rgba(255,255,255,.35);
    font-family: 'TBTeko', Impact, sans-serif;
    font-size: 46px; line-height: 60px; text-align: center;
    box-shadow: 0 6px 14px rgba(0,0,0,.35);
  }
  .who { position: absolute; top: 430px; left: 0; width: 340px; height: 78px; background: #0c1422; padding: 10px 16px 0; }
  .pname {
    font-family: 'TBName', 'Oswald', sans-serif;
    color: #fff; letter-spacing: 0.4px; line-height: 1;
    white-space: nowrap; overflow: hidden;
  }
  .role {
    margin-top: 6px;
    font-family: 'TBLabel', 'Montserrat', sans-serif;
    font-size: 12px; letter-spacing: 1.4px; color: #9eb0c9;
    white-space: nowrap; overflow: hidden;
  }
  .teamrow {
    position: absolute; top: 508px; left: 0; width: 340px; height: 132px;
    display: table; background: #0c1422;
    border-top: 1px solid rgba(255,255,255,.08);
  }
  .tlogo, .tcopy { display: table-cell; vertical-align: middle; }
  .tlogo { width: 108px; padding-left: 18px; }
  .tlogo img { display: block; width: 74px; height: 74px; }
  .tph {
    width: 74px; height: 74px; border-radius: 37px;
    background: #182236; border: 1px solid rgba(255,255,255,.2);
    color: #fff; font-family: 'TBLabel', 'Montserrat', sans-serif;
    font-size: 18px; line-height: 72px; text-align: center;
  }
  .tname {
    font-family: 'TBTeam', 'Montserrat', sans-serif;
    color: #fff; letter-spacing: 0.3px; line-height: 1.15;
    padding-right: 14px;
    white-space: nowrap; overflow: hidden;
  }
  .price {
    position: absolute; top: 640px; left: 0; width: 340px; height: 146px;
    text-align: center;
    background-image: -webkit-linear-gradient(top, #fff3c4 0%, #f6d36a 28%, #e2b034 62%, #c49216 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
  }
  .soldfor {
    padding-top: 14px;
    font-family: 'TBLabel', 'Montserrat', sans-serif;
    font-size: 13px; letter-spacing: 2.4px; color: #6d5214;
  }
  .amount {
    margin-top: 4px;
    font-family: 'TBPrice', 'Anton', sans-serif;
    color: #1a1404; letter-spacing: 0.5px; line-height: 1;
    white-space: nowrap; overflow: hidden;
  }
</style>
</head>
<body>
<div class="sheet">
  <img class="bg" t-att-src="stadium_uri" width="1920" height="1080" alt=""/>
  <div class="veil"></div>

  <div class="brand"><t t-raw="brand_logo_svg"/></div>

  <div class="tmark">
    <t t-if="tournament_logo_uri">
      <img t-att-src="tournament_logo_uri" width="96" height="96" alt=""/>
    </t>
    <t t-else="">
      <div class="tmark-ph"><t t-esc="tournament_initials"/></div>
    </t>
  </div>

  <div class="mast">
    <div class="tourn" t-att-style="title_style"><t t-esc="tournament_name"/></div>
    <t t-if="description">
      <div class="tdesc" t-att-style="desc_style"><t t-esc="description"/></div>
    </t>
    <div class="top5">TOP 5</div>
    <div class="bids">BIDS</div>
  </div>

  <t t-foreach="cards" t-as="card">
    <div class="card" t-att-style="card['box_style']">
      <div class="photo">
        <t t-if="card['photo_uri']">
          <img t-att-src="card['photo_uri']" width="340" height="430" alt=""/>
        </t>
        <t t-else="">
          <div class="ph"><t t-esc="card['initials']"/></div>
        </t>
        <div class="wash" t-att-style="card['wash_style']"></div>
        <div class="badge" t-att-style="card['badge_style']"><t t-esc="card['rank']"/></div>
      </div>
      <div class="who">
        <div class="pname" t-att-style="card['name_style']"><t t-esc="card['player_name']"/></div>
        <div class="role"><t t-esc="card['role']"/></div>
      </div>
      <div class="teamrow">
        <div class="tlogo">
          <t t-if="card['team_logo_uri']">
            <img t-att-src="card['team_logo_uri']" width="74" height="74" alt=""/>
          </t>
          <t t-else="">
            <div class="tph"><t t-esc="card['team_initials']"/></div>
          </t>
        </div>
        <div class="tcopy">
          <div class="tname" t-att-style="card['team_style']"><t t-esc="card['team_name']"/></div>
        </div>
      </div>
      <div class="price">
        <div class="soldfor">SOLD FOR</div>
        <div class="amount" t-att-style="card['amount_style']"><t t-esc="card['points_display']"/></div>
      </div>
    </div>
  </t>
</div>
</body>
</html>
</template>
</odoo>
