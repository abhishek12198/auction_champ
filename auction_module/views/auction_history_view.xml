<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>



        <record id="view_auction_history_tree" model="ir.ui.view">
            <field name="name">auction.history.tree</field>
            <field name="model">auction.history</field>
            <field name="arch" type="xml">

                <tree string="History" create="0" edit="0">
                    <field name="create_date"/>
                    <field name="team_id"/>
                    <field name="message"/>
                    <field name="tournament_id" groups="auction_module.group_auction_group_admin"/>
                </tree>
            </field>
        </record>

        <record id="view_auction_history_search" model="ir.ui.view">
            <field name="name">auction.history.search</field>
            <field name="model">auction.history</field>
            <field name="arch" type="xml">
                <search string="Auction History">
                    <field name="message" string="Message"/>
                    <field name="team_id" string="Team"/>
                    <field name="tournament_id" string="Tournament"
                           groups="auction_module.group_auction_group_admin"/>
                    <filter string="Archived" name="archived"
                            domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_auction_history_tree" model="ir.actions.act_window">
            <field name="name">Auction History</field>
            <field name="res_model">auction.history</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Custom timeline / list board (opened from Tournament smart button) -->
        <record id="action_auction_history_board" model="ir.actions.client">
            <field name="name">Auction History Board</field>
            <field name="tag">auction_module.auction_history_board</field>
            <field name="target">current</field>
        </record>

    </data>
</odoo>
