<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Gavel-only favicon (matches browser tabs). Uses company favicon from
      Settings when custom; else static favicon.png — not the wordmark icon.png.
    -->
    <template id="page_head_favicon" name="Page Head Favicon">
        <t t-set="fav_url" t-value="request.env['auction.tournament'].get_brand_favicon_absolute_url(favicon_db_name or db_name)"/>
        <link rel="icon" t-att-href="fav_url" type="image/png" sizes="128x128"/>
        <link rel="shortcut icon" t-att-href="fav_url" type="image/png"/>
        <link rel="apple-touch-icon" t-att-href="fav_url"/>
    </template>
</odoo>
