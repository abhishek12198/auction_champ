<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Extend res.users form to add auction tournament/team assignment -->
        <record id="view_users_auction_form_inherit" model="ir.ui.view">
            <field name="name">res.users.auction.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <!-- Add AuctionChamp tab after the existing tabs -->
                <xpath expr="//notebook" position="inside">
                    <page string="AuctionChamp" name="auction_champ">
                        <group>
                            <!-- Admin sees/sets the tournament assignment for any user -->
                            <group string="Tournament Assignment"
                                   groups="auction_module.group_auction_group_admin">
                                <field name="tournament_id" string="Active Tournament"
                                       placeholder="Select tournament..."
                                       help="Required for Auction User / Dashboard / Payment Tracker. Scopes menus and record rules. Auction Users with several Organizer Tournaments switch this from the navbar badge. Auto-filled from Organizer Tournaments when empty."/>
                                <field name="tournament_ids" widget="many2many_tags"
                                       string="Organizer Tournaments"
                                       help="Tournaments this user may access. The navbar switcher lists these. Synced when Active Tournament is set, or when the user is added as an Organizer on a tournament. Record rules use this list."/>
                            </group>
                            <!-- Owner/Admin can set the team assignment -->
                            <group string="Team Assignment">
                                <field name="team_id" string="Team"
                                       placeholder="Select team..."
                                       groups="auction_module.group_auction_group_admin"/>
                                <field name="team_id" string="My Team"
                                       readonly="1"
                                       groups="auction_module.group_auction_owner"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Slim "Change My Preferences": labeled photo, name, phone, password -->
        <record id="view_users_simple_auction_form_inherit" model="ir.ui.view">
            <field name="name">res.users.auction.simple.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <field name="image_1920" position="replace"/>
                <xpath expr="//h1" position="replace">
                    <field name="image_1920" widget="image" readonly="0"
                           class="oe_right oe_avatar" nolabel="1"
                           options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>
                    <group>
                        <field name="name" readonly="0" string="Name"/>
                        <field name="phone" widget="phone" readonly="0" string="Phone"/>
                        <div colspan="2">
                            <div class="o_form_label">Password</div>
                            <button name="preference_change_password" type="object"
                                    string="Change Password" class="btn btn-secondary"/>
                        </div>
                    </group>
                </xpath>
                <xpath expr="//notebook" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Admin-only simple user manager (Auction Settings → Configuration → Users) -->
        <record id="view_auction_user_tree" model="ir.ui.view">
            <field name="name">res.users.auction.simple.tree</field>
            <field name="model">res.users</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <tree string="Users" decoration-muted="active == False">
                    <field name="name"/>
                    <field name="login"/>
                    <field name="auction_user_template_id"/>
                    <field name="tournament_id"/>
                    <field name="auction_access_group_ids" widget="many2many_tags"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_auction_user_form" model="ir.ui.view">
            <field name="name">res.users.auction.simple.form</field>
            <field name="model">res.users</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <form string="User">
                    <header>
                        <button name="action_auction_generate_password" type="object"
                                string="Generate new password"
                                class="btn-secondary"
                                confirm="Replace this user's password and show the new one for 10 minutes?"
                                attrs="{'invisible': [('id', '=', False)]}"/>
                    </header>
                    <sheet>
                        <div class="o_auction_temp_pw_banner"
                             attrs="{'invisible': [('auction_temp_password_visible', '=', False)]}">
                            <div class="o_auction_temp_pw_title">Temporary password — copy it now</div>
                            <field name="auction_temp_password_visible" invisible="1"/>
                            <field name="auction_temp_password_shown" widget="CopyClipboardChar"
                                   nolabel="1" readonly="1"/>
                            <field name="auction_temp_password_hint" nolabel="1" readonly="1"
                                   class="o_auction_temp_pw_hint"/>
                        </div>
                        <group>
                            <group string="Login">
                                <field name="name" placeholder="Full name"/>
                                <field name="login" string="Email / Login" placeholder="user@example.com"/>
                                <field name="email" invisible="1"/>
                                <field name="auction_user_template_id"
                                       placeholder="Select a template…"
                                       options="{'no_quick_create': True}"/>
                                <field name="active"/>
                            </group>
                            <group string="Tournament">
                                <field name="tournament_id" string="Active Tournament"/>
                                <field name="tournament_ids" widget="many2many_tags"
                                       string="Organizer Tournaments"/>
                                <field name="team_id"/>
                            </group>
                        </group>
                        <group string="Auction Access">
                            <field name="auction_access_group_ids" widget="many2many_checkboxes"
                                   nolabel="1"
                                   domain="[('category_id.name', '=', 'Auction')]"
                                   attrs="{'readonly': [('auction_user_template_id', '!=', False)]}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_auction_user_search" model="ir.ui.view">
            <field name="name">res.users.auction.simple.search</field>
            <field name="model">res.users</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="login"/>
                    <field name="auction_user_template_id"/>
                    <field name="tournament_id"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_auction_users" model="ir.actions.act_window">
            <field name="name">Users</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('share', '=', False)]</field>
            <field name="context">{'auction_simple_user': 1, 'search_default_active': 1}</field>
            <field name="search_view_id" ref="view_auction_user_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create an auction user</p>
                <p>Set a name, login email, tournament, and Auction access. A 10-character password is generated on save and stays visible for 10 minutes so you can copy it.</p>
            </field>
        </record>
        <record id="action_auction_users_tree" model="ir.actions.act_window.view">
            <field name="sequence">1</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_auction_user_tree"/>
            <field name="act_window_id" ref="action_auction_users"/>
        </record>
        <record id="action_auction_users_form" model="ir.actions.act_window.view">
            <field name="sequence">2</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_auction_user_form"/>
            <field name="act_window_id" ref="action_auction_users"/>
        </record>

    </data>
</odoo>
