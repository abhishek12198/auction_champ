<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="youtube_overlay_template" name="Auction YouTube Overlay">
<html lang="en"
      t-att-data-theme="theme"
      t-att-data-mode="mode or 'dark'"
      t-att-data-page="page or 'obs'"
      t-att-data-sport="sport or 'cricket'"
      t-att-data-overlay-status="overlay_status or 'ok'"
      t-att-data-sse-enabled="'1' if sse_enabled else '0'"
      t-att-data-tournament-id="tournament.id if tournament else ''">
    <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <title>
    <t t-if="page == 'watch'">Watch — </t>
    <t t-else="">Overlay — </t>
    <t t-if="tournament"><t t-esc="tournament.name"/></t>
    <t t-else="">AuctionChamp</t>
  </title>
  <t t-call="auction_module.page_head_favicon"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="1"/>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Exo+2:wght@500;600;700;800;900&amp;family=Barlow+Condensed:wght@600;700&amp;display=swap" rel="stylesheet"/>
  <link rel="stylesheet" t-att-href="'/auction_module/static/src/css/youtube_overlay.css?v=1.5.983'"/>
</head>
<body>
  <t t-if="page == 'watch'">
    <div id="ytWatchStage">
      <t t-if="youtube_embed_id">
        <iframe id="ytWatchFrame"
                t-att-src="'https://www.youtube-nocookie.com/embed/' + youtube_embed_id + '?autoplay=1&amp;modestbranding=1&amp;rel=0&amp;playsinline=1&amp;fs=0'"
                allow="autoplay; encrypted-media; picture-in-picture"
                title="YouTube live"/>
      </t>
      <t t-else="">
        <div class="ytov-watch-empty">
          <div class="ytov-watch-empty-card">
            <h1>Stream not linked</h1>
            <p>Ask the organiser to paste a YouTube Watch or Live URL on the tournament. Player graphics still update above this message.</p>
          </div>
        </div>
      </t>
    </div>
    <button type="button" id="ytWatchFs" class="ytov-watch-fs" title="Fullscreen with auction overlay">Fullscreen</button>
    <button type="button" id="ytWatchLandscape" class="ytov-watch-landscape" title="Switch to landscape mode">Landscape</button>
  </t>

  <div id="ytov-root" class="auctionchamp-live-overlay" data-state="idle" data-conn="connecting">
    <header class="bc-top">
      <div class="bc-brand">
        <img class="bc-brand-logo" src="/auction_module/static/src/assets/images/logo.svg" alt="AuctionChamp"/>
        <span class="bc-live" id="ytovConn"><span class="bc-live-dot"/>LIVE</span>
      </div>
      <div class="bc-tournament">
        <svg class="bc-trophy" viewBox="0 0 48 32" aria-hidden="true">
          <path d="M8 14c0-6 4-10 10-10h2c1 4 4 6 8 6h8c-2 6-8 10-16 10-4 0-8-2-10-5l-2-1z" fill="#f5c451"/>
          <path d="M24 20v6M18 28h12" stroke="#f5c451" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
        <t t-if="tournament_logo_url">
          <img class="bc-t-logo" t-att-src="tournament_logo_url" alt=""/>
        </t>
        <span class="bc-t-name"><t t-esc="tournament.name if tournament else 'AuctionChamp'"/></span>
        <svg class="bc-trophy" viewBox="0 0 48 32" aria-hidden="true">
          <path d="M40 14c0-6-4-10-10-10h-2c-1 4-4 6-8 6H12c2 6 8 10 16 10 4 0 8-2 10-5l2-1z" fill="#f5c451"/>
          <path d="M24 20v6M18 28h12" stroke="#f5c451" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
    </header>

    <div class="bc-notices">
      <div class="pause-banner" id="ytovPaused" hidden="hidden">AUCTION PAUSED</div>
      <div class="complete-banner" id="ytovCompleted" hidden="hidden">
        <span class="complete-kicker">AUCTION COMPLETED</span>
        <span class="complete-stats" id="ytovCompleteStats"></span>
      </div>
      <div class="wait-chip" id="ytovWait">COMING UP NEXT</div>
    </div>

    <div class="bc-punch" id="ytovPunch" data-kind="sold" hidden="hidden">
      <div class="bc-punch-glow"></div>
      <div class="bc-punch-seal">
        <img class="bc-punch-mark" src="/auction_module/static/img/sold_overlay_gray.png" alt=""/>
      </div>
    </div>

    <section class="bc-lower" id="ytovPlayer" hidden="hidden">
      <div class="ipl-player-card">
        <div class="bc-photo-col">
          <div class="ipl-photo-ph" id="ytovPhotoPh">&#9733;</div>
          <img class="ipl-photo" id="ytovPhoto" alt="" src="/auction_module/static/description/icon.png"/>
          <span class="bc-icon" id="ytovIcon" hidden="hidden">&#9819; ICON</span>
          <span class="ipl-lot" id="ytovLot" hidden="hidden"></span>
        </div>
        <div class="bc-player">
          <div class="ipl-name" id="ytovName"></div>
          <div class="ipl-chips" id="ytovChips"></div>
          <div class="bc-meta" id="ytovMeta"></div>
          <div class="ipl-stamp" id="ytovStamp" hidden="hidden"></div>
        </div>
        <div class="bc-bid" id="ytovLiveBox">
          <div class="bc-bid-label" id="ytovLiveLabel" hidden="hidden"></div>
          <div class="bc-bid-row">
            <span class="bc-bid-val" id="ytovBidVal"></span>
            <svg class="bc-gavel" viewBox="0 0 64 64" aria-hidden="true">
              <path d="M18 38l16-16 8 8-16 16-8-8z" fill="#f5c451"/>
              <path d="M14 42l8 8" stroke="#f5c451" stroke-width="6" stroke-linecap="round"/>
              <path d="M28 50h22" stroke="#f5c451" stroke-width="5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="bc-base" id="ytovBase">BASE <span id="ytovBaseVal"></span></div>
        </div>
        <div class="bc-team" id="ytovBidTeam" hidden="hidden">
          <div class="bc-team-label" id="ytovTeamLabel">Now Auctioning</div>
          <div class="bc-team-row" id="ytovTeamRow" hidden="hidden">
            <img class="ipl-bid-team-logo" id="ytovBidTeamLogo" alt="" hidden="hidden"/>
            <span class="ipl-bid-team-ph" id="ytovBidTeamLogoPh" hidden="hidden"></span>
            <span class="bc-team-name" id="ytovBidTeamName"></span>
          </div>
          <div class="bc-timer" id="ytovTimer" hidden="hidden">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 13V9M9 4h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span id="ytovTimerVal">00:00</span>
          </div>
        </div>
      </div>
    </section>

    <footer class="bc-ticker" id="ytovTicker" hidden="hidden">
      <div class="bc-stat"><span>SOLD</span><b id="ytovSold">0</b></div>
      <div class="bc-stat"><span>REMAINING</span><b id="ytovRemain">0</b></div>
      <div class="bc-stat bc-stat-spend"><span>TOTAL SPEND</span><b id="ytovSpend">0</b></div>
      <div class="bc-recent">
        <span class="bc-recent-label">RECENT SALES</span>
        <div class="bc-recent-track" id="ytovRecent"></div>
      </div>
      <div class="sponsor-display" id="ytovSponsor" hidden="hidden">
        <div class="sponsor-track" id="ytovSponsorTrack"></div>
      </div>
    </footer>
  </div>

  <script type="text/javascript">
    window.YTOV_DB = '<t t-esc="db_name or ''"/>';
    window.YTOV_SLUG = '<t t-esc="tournament_slug or ''"/>';
    window.YTOV_TOURNAMENT_ID = '<t t-esc="tournament.id if tournament else ''"/>';
    window.YTOV_DATA_URL = '/' + window.YTOV_DB + '/auction/yt-overlay/' + window.YTOV_SLUG + '/data';
    window.YTOV_EVENTS_URL = '/' + window.YTOV_DB + '/auction/yt-overlay/' + window.YTOV_SLUG + '/events';
    window.YTOV_SSE_ENABLED = document.documentElement.getAttribute('data-sse-enabled') || '0';
  </script>
  <t t-call="auction_module.point_unit_bootstrap">
    <t t-set="pu_tournament" t-value="tournament"/>
  </t>
  <script src="/auction_module/static/src/js/auction_sse_client.js"/>
  <script src="/auction_module/static/src/js/youtube_overlay.js?v=1.5.983"/>
</body>
</html>
</template>
</odoo>
