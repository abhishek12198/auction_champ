<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Early <head> include so mystery masks apply on first paint (no identity flash). -->
<template id="player_mystery_critical_css" name="Mystery Player Critical CSS">
<style>
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sp-image,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-photo-col,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-photo-col,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-photo-col,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-photo-col,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-photo-panel {
    position: relative !important;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sp-image img:not(.ac-mystery-generic-avatar),
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-photo-col img:not(.ac-mystery-generic-avatar),
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-photo-col img:not(.ac-mystery-generic-avatar),
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-photo-col img:not(.ac-mystery-generic-avatar),
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-photo-col img:not(.ac-mystery-generic-avatar),
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-photo-panel img:not(.ac-mystery-generic-avatar),
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) #loadImage {
    visibility: hidden !important;
    opacity: 0 !important;
  }
  /* Full-frame generic avatar (covers portrait slot completely) */
  .ac-mystery-generic-avatar {
    display: none !important;
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center center !important;
    filter: grayscale(1) brightness(0.72) contrast(0.95);
    border-radius: inherit;
    z-index: 5 !important;
    pointer-events: none;
    margin: 0 !important;
    padding: 0 !important;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .ac-mystery-generic-avatar {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  /* Fallback gray plate before avatar img mounts */
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sp-image::before,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-photo-col::before,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-photo-col::before,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-photo-col::before,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-photo-col::before,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-photo-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: #4a5568;
    border-radius: inherit;
    z-index: 4;
    pointer-events: none;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sp-image::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-photo-col::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-photo-col::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-photo-col::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-photo-col::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-photo-panel::after {
    content: '🔐 PLAYER LOCKED\A Requires Winning Bid';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    font-family: 'Rajdhani', 'Orbitron', 'Teko', sans-serif;
    font-size: clamp(1rem, 2.4vw, 1.45rem);
    font-weight: 800;
    line-height: 1.55;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    white-space: pre-line;
    color: #fff;
    text-shadow:
      0 2px 10px rgba(0, 0, 0, .75),
      0 0 18px rgba(0, 0, 0, .45);
    background: linear-gradient(
      180deg,
      rgba(30, 35, 45, .28) 0%,
      rgba(20, 24, 32, .52) 100%
    );
    border-radius: inherit;
    z-index: 6;
    pointer-events: none;
    padding: 1.25rem;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-photo-overlay,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-photo-overlay,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-photo-name-block {
    /* Keep overlay in layout so Base Price can remain visible; identity stays masked below */
    visibility: visible !important;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-photo-overlay .hud-player-name,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-photo-overlay .hud-role-tag,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-photo-overlay .cr-id-name,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-photo-overlay .cr-role-tag,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-photo-name-block .pt-player-name,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-photo-name-block .pt-player-role {
    visibility: hidden !important;
    opacity: 0 !important;
  }
  /* Base price must stay visible for mystery bidding */
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .player-base-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-base-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-base-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-base-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-base-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-base-badge {
    visibility: visible !important;
    opacity: 1 !important;
    position: relative;
    z-index: 8;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) [data-sm-name],
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) [data-sm-role] {
    position: relative !important;
    color: transparent !important;
    text-shadow: none !important;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) [data-sm-name] *,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) [data-sm-role] * {
    color: transparent !important;
    text-shadow: none !important;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) [data-sm-name]::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) [data-sm-role]::after {
    content: '?';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: 'Orbitron', 'Teko', 'Anton', sans-serif;
    font-weight: 800;
    font-size: 1.15em;
    line-height: 1;
    color: #fdce33;
    text-shadow: 0 0 18px rgba(253,206,51,.45), 0 4px 14px rgba(0,0,0,.35);
    pointer-events: none;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .player-profession-body,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-stats-wrap,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-stats-wrap,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-stats,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-stats-col,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-stats-grid {
    position: relative !important;
    min-height: 4.5rem;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .player-profession-body > *,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-stats-wrap > *,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-stats-wrap > *,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-stats > *,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-stats-col > *,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-stats-grid > * {
    visibility: hidden !important;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .player-profession-body::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-stats-wrap::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-stats-wrap::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-stats::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-stats-col::after,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-stats-grid::after {
    content: '?';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', 'Teko', 'Anton', sans-serif;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    color: #fdce33;
    text-shadow: 0 0 22px rgba(253,206,51,.35), 0 6px 18px rgba(0,0,0,.4);
    background: rgba(15,23,42,.28);
    border-radius: 12px;
    z-index: 2;
    pointer-events: none;
  }
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .stroke-only,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-serial-block,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-photo-wm,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-serial-block,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-photo-wm,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-serial-watermark,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-serial-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-serial-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-serial-watermark,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-photo-serial {
    visibility: hidden !important;
    opacity: 0 !important;
  }
  /* Tier name / badge — hide until reveal */
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .player-tier-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .lm-tier-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .sw-tier-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-tier-strip,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .hud-tier-hex,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .cr-tier-badge,
  body[data-is-mystery="1"]:not([data-mystery-revealed="1"]) .pt-tier-badge {
    visibility: hidden !important;
    opacity: 0 !important;
  }
</style>
</template>
</odoo>
