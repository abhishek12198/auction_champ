<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dedicated football PDF card page (called per-doc by dispatchers) -->
    <template id="report_player_card_football_page">
        <t t-set="fbc_print_themes" t-value="{
  'vanilla':      {'baseDark':'#142846','panel':'#1a3560','panelLite':'#2a4568','header':'#3d5f94','headerLite':'#5b7eb8','circleLite':'#8aa6d4','accent':'#c8d4e8','accentD':'#8aa6d4','ink':'#142846','muted':'#a8bdd8','txt':'#ffffff','blood':'#ff6b6b','brandGlow':'91,126,184','accentGlow':'200,212,232'},
  'butterscotch': {'baseDark':'#170f04','panel':'#241809','panelLite':'#4a3210','header':'#7c531a','headerLite':'#b3801f','circleLite':'#d99a2a','accent':'#f5c842','accentD':'#e0901f','ink':'#241809','muted':'#d8b98a','txt':'#fff7e6','blood':'#ff6b6b','brandGlow':'245,200,66','accentGlow':'245,200,66'},
  'strawberry':   {'baseDark':'#F8BBD0','panel':'#FFF5F9','panelLite':'#FFF0F5','header':'#C2185B','headerLite':'#E91E63','circleLite':'#FFD6E8','accent':'#880E4F','accentD':'#9d174d','ink':'#FFF5F9','muted':'#9d174d','txt':'#1a0a12','blood':'#ad1457','brandGlow':'194,24,91','accentGlow':'136,14,79','capsuleBg':'#1a0a12','capsuleTxt':'#FFF5F9','titleFont':'Atlanta College'},
  'cherry':       {'baseDark':'#150304','panel':'#180405','panelLite':'#4a0a13','header':'#7a0a18','headerLite':'#9a0f22','circleLite':'#dc143c','accent':'#f5c842','accentD':'#c01530','ink':'#180405','muted':'#e0a0a8','txt':'#ffecec','blood':'#ff4d64','brandGlow':'220,20,60','accentGlow':'245,200,66'},
  'pistah':       {'baseDark':'#061309','panel':'#0c2411','panelLite':'#1c4d2a','header':'#2f7d32','headerLite':'#38a13c','circleLite':'#6bbf4e','accent':'#d4e157','accentD':'#2f7d32','ink':'#06140a','muted':'#a7d1a0','txt':'#ecfce8','blood':'#ff7a6b','brandGlow':'107,191,78','accentGlow':'212,225,87'},
  'lemon':        {'baseDark':'#E8DDB8','panel':'#F7F1DC','panelLite':'#FBF6E8','header':'#C9A400','headerLite':'#D9B820','circleLite':'#F7F1DC','accent':'#8F7400','accentD':'#6E5A00','ink':'#F7F1DC','muted':'#5C4A14','txt':'#1F1A0A','blood':'#b91c1c','brandGlow':'140,110,0','accentGlow':'143,116,0','capsuleBg':'#1F1A0A','capsuleTxt':'#F7F1DC','titleFont':'Atlanta College'},
  'blackberry':   {'baseDark':'#050a14','panel':'#0a1628','panelLite':'#14305f','header':'#1e3a8a','headerLite':'#2563eb','circleLite':'#3b82f6','accent':'#60a5fa','accentD':'#1e3a8a','ink':'#050a14','muted':'#93c5fd','txt':'#ffffff','blood':'#ff7a6b','brandGlow':'59,130,246','accentGlow':'96,165,250','titleFont':'Atlanta College'},
}"/>
        <t t-set="pal" t-value="fbc_print_themes.get(doc.tournament_id.player_display_template or 'vanilla', fbc_print_themes['vanilla'])"/>
        <t t-set="title_font" t-value="pal.get('titleFont', 'Varsity Team')"/>
        <html lang="en">
            <head>
                <title>Football Player Card</title>
                <style>@font-face{font-family:'Varsity Team';src:url('/auction_module/static/src/assets/fonts/VarsityTeam-Bold.otf') format('opentype');font-weight:normal;font-style:normal;}@font-face{font-family:'Atlanta College';src:url('/auction_module/static/src/assets/fonts/Atlanta-College.ttf') format('truetype');font-weight:normal;font-style:normal;} html,body{margin:0;}</style>
            </head>
            <body t-attf-style="margin:0; padding:10px; font-family:'Barlow',sans-serif; background-color:{{ pal['baseDark'] }}; background-image:-webkit-radial-gradient(14% -10%, circle, rgba({{ pal['brandGlow'] }},0.42) 0%, rgba({{ pal['brandGlow'] }},0) 40%), -webkit-radial-gradient(86% -10%, circle, rgba({{ pal['brandGlow'] }},0.38) 0%, rgba({{ pal['brandGlow'] }},0) 40%), -webkit-radial-gradient(50% 125%, circle, rgba({{ pal['accentGlow'] }},0.15) 0%, rgba({{ pal['accentGlow'] }},0) 52%), -webkit-linear-gradient(top, {{ pal['panel'] }} 0%, {{ pal['baseDark'] }} 52%, {{ pal['baseDark'] }} 100%);">
                <!-- Same shell as cricket (832px / paperformat_card_landscape) so both sports fill one page identically. -->
                <div t-attf-style="max-width:832px; margin:0 auto; border-radius:14px; overflow:hidden; background-color:{{ pal['panel'] }}; background-image:-webkit-linear-gradient(top,{{ pal['panelLite'] }} 0%,{{ pal['baseDark'] }} 100%); box-shadow:0 0 0 2px rgba({{ pal['accentGlow'] }},0.6), 0 0 0 5px rgba(0,0,0,0.6), 0 16px 40px rgba(0,0,0,0.55);">

                    <!-- HEADER -->
                    <div t-attf-style="border-radius:14px 14px 0 0; border-bottom:2px solid rgba({{ pal['accentGlow'] }},0.85); background-color:{{ pal['header'] }}; background-image:-webkit-radial-gradient(92% -60%, circle, rgba({{ pal['accentGlow'] }},0.30) 0%, rgba({{ pal['accentGlow'] }},0) 60%), -webkit-linear-gradient(left, {{ pal['header'] }} 0%, {{ pal['headerLite'] }} 55%, {{ pal['header'] }} 100%);">
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="vertical-align:middle; padding:11px 18px; width:60px;">
                                    <div t-attf-style="width:48px; height:48px; padding:3px; border-radius:8px; background-color:rgba(255,255,255,0.14); box-shadow:0 0 0 1px rgba({{ pal['accentGlow'] }},0.5); text-align:center;">
                                        <img t-att-src="image_data_uri(doc.tournament_id.logo_card or doc.tournament_id.logo)" alt="Logo" style="height:42px; width:42px; object-fit:contain; display:inline-block; border-radius:5px; vertical-align:middle;"/>
                                    </div>
                                </td>
                                <td style="vertical-align:middle; padding:11px 0;">
                                    <div t-attf-style="color:{{ pal['txt'] }}; font-family:'{{ title_font }}','Bebas Neue',sans-serif; font-size:1.7rem; letter-spacing:1.4px; text-transform:uppercase; line-height:1; text-shadow:0 2px 6px rgba(0,0,0,0.45); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:34ch;" t-esc="doc.tournament_id.name"/>
                                    <div t-attf-style="color:{{ pal['accent'] }}; font-size:0.68rem; font-weight:600; margin-top:3px; letter-spacing:2px; text-transform:uppercase;" t-esc="doc.tournament_id.description"/>
                                </td>
                                <td style="vertical-align:middle; text-align:right; padding:11px 20px; white-space:nowrap;">
                                    <span t-attf-style="display:inline-block; padding:5px 14px; border-radius:20px; background-color:{{ pal.get('capsuleBg', 'rgba(0,0,0,0.28)') }}; box-shadow:0 0 0 2px {{ pal.get('capsuleTxt', pal['accent']) }}; color:{{ pal.get('capsuleTxt', pal['accent']) }}; font-family:'Oswald',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:3px; text-transform:uppercase;">Player Card</span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- BODY -->
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td t-attf-style="width:264px; min-width:264px; vertical-align:top; padding:0; background-color:{{ pal['panel'] }}; background-image:-webkit-radial-gradient(50% 4%, circle, rgba({{ pal['brandGlow'] }},0.34) 0%, rgba({{ pal['brandGlow'] }},0) 55%), -webkit-linear-gradient(top,{{ pal['panelLite'] }} 0%,{{ pal['baseDark'] }} 100%); border-right:2px solid rgba({{ pal['accentGlow'] }},0.3);">
                                <div style="padding:14px 11px 14px 14px;">
                                    <div t-attf-style="height:300px; border-radius:10px; overflow:hidden; border-top:5px solid {{ pal['accent'] }}; border-bottom:5px solid {{ pal['accent'] }}; box-shadow:0 0 0 2px {{ pal['accent'] }}, 0 0 0 5px rgba(0,0,0,0.5), 0 8px 22px rgba(0,0,0,0.5); background-color:{{ pal['baseDark'] }};">
                                        <!-- Use <img> (not CSS background-image): wkhtmltopdf often drops
                                             long data: URIs in background-image, leaving a black box. -->
                                        <t t-set="card_photo" t-value="doc._get_card_print_photo()"/>
                                        <t t-if="card_photo">
                                            <img t-att-src="image_data_uri(card_photo)"
                                                 alt="Player Photo"
                                                 style="width:100%; height:300px; display:block;"/>
                                        </t>
                                    </div>
                                </div>
                            </td>

                            <td style="vertical-align:top; padding:0;">
                                <div t-attf-style="position:relative; min-height:328px; background-color:{{ pal['panel'] }}; background-image:-webkit-radial-gradient(100% 0%, circle, rgba({{ pal['brandGlow'] }},0.20) 0%, rgba({{ pal['brandGlow'] }},0) 50%), -webkit-linear-gradient(top left, {{ pal['panelLite'] }} 0%, {{ pal['panel'] }} 100%);">

                                    <div t-attf-style="position:absolute; top:15px; right:18px; width:56px; height:56px; border-radius:50%; background-color:{{ pal['header'] }}; background-image:-webkit-linear-gradient(top left,{{ pal['circleLite'] }},{{ pal['header'] }}); box-shadow:0 0 0 3px {{ pal['accent'] }}, 0 0 0 6px rgba(0,0,0,0.55), 0 6px 16px rgba(0,0,0,0.5); text-align:center; line-height:56px;">
                                        <span t-attf-style="color:{{ pal['accent'] }}; font-family:'{{ title_font }}','Bebas Neue',sans-serif; font-size:1.7rem; vertical-align:middle;"><t t-esc="doc.sl_no"/></span>
                                    </div>

                                    <div style="padding:10px 74px 7px 22px;">
                                        <div t-attf-style="color:{{ pal['txt'] }}; font-family:'{{ title_font }}','Bebas Neue',sans-serif; font-size:1.85rem; line-height:0.98; letter-spacing:1px; text-transform:uppercase; text-shadow:0 3px 9px rgba(0,0,0,0.5); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" t-esc="doc.name.upper()"/>
                                        <div style="margin-top:4px;">
                                            <t t-if="doc.dominant_position_id or doc.role">
                                                <span t-attf-style="display:inline-block; color:{{ pal['ink'] }}; background-color:{{ pal['accent'] }}; background-image:-webkit-linear-gradient(left,{{ pal['accent'] }},{{ pal['accentD'] }}); font-family:'Oswald',sans-serif; font-size:0.72rem; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; padding:2px 12px; border-radius:4px; white-space:nowrap;"><t t-esc="doc.dominant_position_id.name if doc.dominant_position_id else doc.role"/></span>
                                            </t>
                                        </div>

                                        <table style="width:100%; border-collapse:collapse; margin:7px 0 3px;">
                                            <tr><td t-attf-style="height:2px; padding:0; background-color:{{ pal['accent'] }}; background-image:-webkit-linear-gradient(left,{{ pal['accent'] }} 0%,rgba({{ pal['accentGlow'] }},0) 82%);"></td></tr>
                                        </table>

                                        <t t-set="lblcss" t-value="'color:' + pal['muted'] + ';font-family:Oswald,sans-serif;font-size:0.54rem;font-weight:500;letter-spacing:0.7px;text-transform:uppercase;line-height:1.1;margin-bottom:1px;'"/>
                                        <t t-set="valcss" t-value="'color:' + pal['txt'] + ';font-family:Barlow,sans-serif;font-size:0.8rem;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'"/>
                                        <t t-set="bloodcss" t-value="'color:' + pal['blood'] + ';font-family:Barlow,sans-serif;font-size:0.8rem;font-weight:700;line-height:1.2;'"/>
                                        <t t-set="tdL" t-value="'width:50%;vertical-align:top;padding:3px 12px 3px 0;border-bottom:1px solid rgba(' + pal['accentGlow'] + ',0.14);'"/>
                                        <t t-set="tdR" t-value="'width:50%;vertical-align:top;padding:3px 0 3px 14px;border-bottom:1px solid rgba(' + pal['accentGlow'] + ',0.14);'"/>
                                        <t t-set="tdLchip" t-value="'width:50%;vertical-align:top;padding:4px 12px 3px 0;border-bottom:1px solid rgba(' + pal['accentGlow'] + ',0.14);'"/>
                                        <t t-set="tdRchip" t-value="'width:50%;vertical-align:top;padding:4px 0 3px 14px;border-bottom:1px solid rgba(' + pal['accentGlow'] + ',0.14);'"/>
                                        <t t-set="chiplbl" t-value="'color:' + pal['accent'] + ';font-family:Oswald,sans-serif;font-size:0.56rem;font-weight:500;letter-spacing:0.8px;text-transform:uppercase;margin-bottom:2px;'"/>
                                        <t t-set="chipcss" t-value="'display:inline-block;border:1px solid ' + pal['accent'] + ';border-radius:6px;padding:1px 6px;color:' + pal['accent'] + ';background:rgba(' + pal['accentGlow'] + ',0.08);font-family:Oswald,sans-serif;font-size:0.55rem;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;margin:0 3px 2px 0;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis;'"/>

                                        <table style="width:100%; table-layout:fixed; border-collapse:collapse; margin-top:2px;">
                                            <tr>
                                                <td t-att-style="tdL">
                                                    <div t-att-style="lblcss">Tier</div>
                                                    <div t-att-style="valcss"><t t-esc="doc.tier_id.name or '—'"/></div>
                                                </td>
                                                <td t-att-style="tdR">
                                                    <div t-att-style="lblcss">Preferred Foot</div>
                                                    <div t-att-style="valcss"><t t-esc="doc.preferred_foot.capitalize() if doc.preferred_foot else '—'"/></div>
                                                </td>
                                            </tr>
                                            <t t-if="doc.use_other_attributes">
                                                <t t-set="oa_rows" t-value="doc.other_attribute_ids.filtered('value')"/>
                                                <t t-foreach="oa_rows" t-as="oattr">
                                                    <t t-if="oattr_index % 2 == 0">
                                                    <tr>
                                                        <td t-att-style="tdL">
                                                            <div t-att-style="lblcss"><t t-esc="oattr.label"/></div>
                                                            <div t-att-style="valcss"><t t-esc="oattr.value or '—'"/></div>
                                                        </td>
                                                        <td t-att-style="tdR">
                                                            <t t-if="oattr_index + 1 &lt; len(oa_rows)">
                                                                <t t-set="oattr2" t-value="oa_rows[oattr_index + 1]"/>
                                                                <div t-att-style="lblcss"><t t-esc="oattr2.label"/></div>
                                                                <div t-att-style="valcss"><t t-esc="oattr2.value or '—'"/></div>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                    </t>
                                                </t>
                                            </t>
                                            <t t-else="">
                                            <tr>
                                                <td t-att-style="tdL">
                                                    <div t-att-style="lblcss">Secondary</div>
                                                    <div t-att-style="valcss"><t t-esc="', '.join(doc.secondary_position_ids.mapped('code')) or '—'"/></div>
                                                </td>
                                                <td t-att-style="tdR">
                                                    <div t-att-style="lblcss">Age</div>
                                                    <div t-att-style="valcss"><t t-esc="(str(doc.age) + ' Years') if doc.age else '—'"/></div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td t-att-style="tdLchip">
                                                    <div t-att-style="chiplbl">Playing Style</div>
                                                    <div>
                                                        <t t-foreach="doc.playing_style_ids" t-as="sty">
                                                            <span t-att-style="chipcss"><t t-esc="sty.name"/></span>
                                                        </t>
                                                        <t t-if="not doc.playing_style_ids"><span t-att-style="valcss">—</span></t>
                                                    </div>
                                                </td>
                                                <td t-att-style="tdRchip">
                                                    <div t-att-style="chiplbl">Strengths</div>
                                                    <div>
                                                        <t t-foreach="doc.strength_ids" t-as="strg">
                                                            <span t-att-style="chipcss"><t t-esc="strg.name"/></span>
                                                        </t>
                                                        <t t-if="doc.work_rate">
                                                            <span t-att-style="chipcss"><t t-esc="doc.work_rate.capitalize()"/> Work Rate</span>
                                                        </t>
                                                        <t t-if="not doc.strength_ids and not doc.work_rate"><span t-att-style="valcss">—</span></t>
                                                    </div>
                                                </td>
                                            </tr>
                                            </t>
                                            <tr>
                                                <td t-att-style="tdL">
                                                    <div t-att-style="lblcss">Mobile</div>
                                                    <div t-att-style="valcss"><t t-esc="doc.masked_contact or '—'"/></div>
                                                </td>
                                                <td t-att-style="tdR">
                                                    <div t-att-style="lblcss">Blood Group</div>
                                                    <div t-att-style="bloodcss"><t t-esc="doc.blood_group or '—'"/></div>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    
                    <!-- FOOTER -->
                    <div t-attf-style="padding:5px 20px; border-radius:0 0 14px 14px; border-top:2px solid rgba({{ pal['accentGlow'] }},0.85); background-color:{{ pal['headerLite'] }}; background-image:-webkit-linear-gradient(left,{{ pal['header'] }},{{ pal['headerLite'] }},{{ pal['header'] }});">
                        <table style="width:100%; border-collapse:collapse;"><tr><td style="vertical-align:middle; text-align:left; padding:0; width:30%;"><t t-if="doc.tournament_id.tournament_date_display"><span t-attf-style="font-size:0.6rem; letter-spacing:1.5px; text-transform:uppercase; font-family:'Oswald',sans-serif; font-weight:600; color:rgba({{ pal['accentGlow'] }},0.85);">&#128197; <t t-esc="doc.tournament_id.tournament_date_display"/></span></t><t t-if="doc.tournament_id.tournament_date_display and doc.tournament_id.venue"><span style="font-size:0.55rem; color:rgba(255,255,255,0.3); margin:0 6px;">|</span></t><t t-if="doc.tournament_id.venue"><span t-attf-style="font-size:0.6rem; letter-spacing:1.2px; text-transform:uppercase; font-family:'Oswald',sans-serif; font-weight:600; color:rgba({{ pal['accentGlow'] }},0.85); max-width:30ch; display:inline-block; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; vertical-align:middle;">&#128205; <t t-esc="doc.tournament_id.venue"/></span></t></td><td style="vertical-align:middle; text-align:center; white-space:nowrap; padding:0;"><span style="font-size:0.6rem; letter-spacing:3px; text-transform:uppercase;"><span t-attf-style="color:rgba({{ pal['accentGlow'] }},0.6); font-weight:400;">Powered by&#160;</span><img src="data:image/svg+xml;base64," alt="Auction Champ" style="height:16px; vertical-align:middle; display:inline-block; margin-left:4px;"/></span></td><td style="padding:0; width:30%;"></td></tr></table>
                    </div>

                </div>
            </body>
        </html>
    </template>

</odoo>
