<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- strawberry card body (lemon layout + strawberry colors) (called per-doc by dispatcher) -->
    <template id="report_player_card_strawberry_page">
        <html lang="en">
            <head>
                <title>Player Card</title>
                <style>@font-face{font-family:'Atlanta College';src:url('/auction_module/static/src/assets/fonts/Atlanta-College.ttf') format('truetype');font-weight:normal;font-style:normal;}</style>
            </head>
            <body style="margin:0; padding:10px; font-family:'Barlow',sans-serif; background-color:#F8BBD0; background-image:-webkit-linear-gradient(top, #FFF0F5 0%, #F8BBD0 55%, #F48FB1 100%);">
                <div style="max-width:832px; margin:0 auto; border-radius:12px; overflow:hidden; background-color:#FFF5F9; box-shadow:0 0 0 2px #880E4F, 0 8px 24px rgba(136,14,79,0.16);">

                    <!-- HEADER — lemon layout, strawberry rose palette -->
                    <div style="border-radius:12px 12px 0 0; border-bottom:3px solid #880E4F; background-color:#C2185B; overflow:hidden;">
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
                            <tr>
                                        <td style="vertical-align:middle; padding:12px 14px 12px 16px; width:76px;">
                                            <div style="width:48px; height:48px; padding:3px; border-radius:6px; background-color:rgba(255,255,255,0.42); box-shadow:0 0 0 1.5px #880E4F; text-align:center;">
                                                <img t-att-src="image_data_uri(doc.tournament_id.logo_card or doc.tournament_id.logo)" alt="Logo" style="height:42px; width:42px; object-fit:contain; display:inline-block; border-radius:4px; vertical-align:middle;"/>
                                            </div>
                                        </td>
                                <td style="vertical-align:middle; padding:12px 8px 12px 0; overflow:hidden;">
                                    <div style="color:#1a0a12; font-family:'Atlanta College','Bebas Neue',sans-serif; font-size:1.55rem; letter-spacing:1.2px; text-transform:uppercase; line-height:1; padding-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" t-esc="doc.tournament_id.name"/>
                                    <div style="color:#9d174d; font-size:0.65rem; font-weight:600; margin-top:3px; letter-spacing:1.5px; text-transform:uppercase; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" t-esc="doc.tournament_id.description"/>
                                </td>
                                <td style="vertical-align:middle; text-align:right; padding:12px 16px 12px 8px; width:132px;">
                                    <span style="display:inline-block; padding:5px 14px; border-radius:20px; background-color:#1a0a12; box-shadow:0 0 0 2px #FFF5F9; color:#FFF5F9; font-family:'Oswald',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; white-space:nowrap;">Player Card</span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- BODY -->
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="width:264px; min-width:264px; vertical-align:top; padding:0;">
                                <div style="padding:14px 11px 14px 14px; background-color:#FFF5F9; border-right:2px solid #F48FB1;">
                                    <div t-att-style="'border-radius:8px; overflow:hidden; border:2px solid #880E4F; border-top:5px solid ' + (doc.tier_id.color if doc.tier_id else '#C2185B') + '; border-bottom:5px solid ' + (doc.tier_id.color if doc.tier_id else '#C2185B') + ';'">
                                        <img t-att-src="image_data_uri(doc._get_card_print_photo())" alt="Player Photo" style="width:100%; height:300px; display:block;"/>
                                    </div>
                                </div>
                            </td>

                            <td style="vertical-align:top; padding:0;">
                                <div style="position:relative; min-height:328px; background-color:#FFF0F5;">

                                    <div style="position:absolute; top:14px; right:16px; width:52px; height:52px; border-radius:8px; background-color:#C2185B; box-shadow:0 0 0 2px #880E4F; text-align:center; line-height:52px;">
                                        <span style="color:#1a0a12; font-family:'Atlanta College','Bebas Neue',sans-serif; font-size:1.55rem; vertical-align:middle;"><t t-esc="doc.sl_no"/></span>
                                    </div>

                                    <div style="padding:18px 78px 16px 24px;">
                                        <div style="color:#1a0a12; font-family:'Atlanta College','Bebas Neue',sans-serif; font-size:2.5rem; line-height:1.15; padding-top:3px; letter-spacing:1px; text-transform:uppercase; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" t-esc="doc.name.upper()"/>
                                        <div style="margin-top:6px;">
                                            <t t-if="doc.role">
                                                <span style="display:inline-block; color:#1a0a12; background-color:#FFD6E8; font-family:'Oswald',sans-serif; font-size:0.78rem; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; padding:3px 14px; border-radius:4px; border:1px solid #880E4F; white-space:nowrap;"><t t-esc="doc.role"/></span>
                                            </t>
                                            <t t-if="doc.tier_id">
                                                <span t-att-style="'display:inline-block; margin-left:6px; background-color:' + (doc.tier_id.color or '#C2185B') + '; color:#1a0a12; padding:4px 14px; border-radius:4px; font-family:Oswald,sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:1.3px; text-transform:uppercase; border:1px solid #880E4F; white-space:nowrap;'"><t t-esc="doc.tier_id.name"/></span>
                                            </t>
                                        </div>


                                        <table style="width:100%; border-collapse:collapse; margin:13px 0 2px;">
                                            <tr><td style="height:2px; padding:0; background-color:#F48FB1;"></td></tr>
                                        </table>

                                        <table style="width:100%; border-collapse:collapse;">
                                <t t-if="doc.tournament_id.tournament_type == 'cricket' and doc.batting_style">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Batting Style</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.batting_style"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'cricket' and doc.bowling_style">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Bowling Style</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.bowling_style"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'football' and doc.dominant_position_id">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Position</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.dominant_position_id.name"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'football' and doc.secondary_position_ids and not doc.use_other_attributes">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Secondary</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="', '.join(doc.secondary_position_ids.mapped('code'))"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'football' and doc.preferred_foot">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Preferred Foot</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.preferred_foot.capitalize()"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'football' and doc.use_other_attributes">
                                    <t t-foreach="doc.other_attribute_ids.filtered('value')" t-as="oattr">
                                        <tr>
                                            <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="oattr.label"/></td>
                                            <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="oattr.value or '—'"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'football' and doc.work_rate and not doc.use_other_attributes">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Work Rate</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.work_rate.capitalize()"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'football' and doc.age and not doc.use_other_attributes">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Age</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.age"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'football' and doc.height">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Height</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.height"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.tournament_id.tournament_type == 'football' and doc.weight">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Weight</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.weight"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.blood_group">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Blood Group</td>
                                        <td style="color:#ad1457; font-size:0.85rem; font-weight:700; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.blood_group"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.address">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Location</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.address"/></td>
                                    </tr>
                                </t>
                                <t t-if="doc.contact">
                                    <tr>
                                        <td style="color:#880E4F; font-family:'Oswald',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:7px 10px 7px 0; white-space:nowrap; width:42%; border-bottom:1px solid #F48FB1; vertical-align:middle;">Mobile</td>
                                        <td style="color:#1a0a12; font-size:0.85rem; font-weight:600; padding:7px 0; border-bottom:1px solid #F48FB1; vertical-align:middle;"><t t-esc="doc.masked_contact"/></td>
                                    </tr>
                                </t>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    
                    <!-- FOOTER -->
                    <div style="padding:8px 20px; border-radius:0 0 12px 12px; border-top:3px solid #880E4F; background-color:#C2185B;">
                        <table style="width:100%; border-collapse:collapse;"><tr><td style="vertical-align:middle; text-align:left; padding:0 8px 0 0; width:32%; max-width:32%;"><div style="display:flex; flex-direction:column; justify-content:center; gap:2px; max-width:100%; overflow:hidden;"><t t-if="doc.tournament_id.tournament_date_display"><span style="font-size:0.55rem; letter-spacing:0.8px; text-transform:uppercase; font-family:'Oswald',sans-serif; font-weight:600; color:#1a0a12; line-height:1.25; white-space:normal; word-break:break-word;">&#128197; <t t-esc="doc.tournament_id.tournament_date_display"/></span></t><t t-if="doc.tournament_id.venue"><span style="font-size:0.55rem; letter-spacing:0.8px; text-transform:uppercase; font-family:'Oswald',sans-serif; font-weight:600; color:#1a0a12; line-height:1.25; max-width:100%; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;">&#128205; <t t-esc="doc.tournament_id.venue"/></span></t></div></td><td style="vertical-align:middle; text-align:center; white-space:nowrap; padding:0;"><span style="font-size:0.6rem; letter-spacing:3px; text-transform:uppercase;"><span style="color:#9d174d; font-weight:600;">Powered by&#160;</span><img src="data:image/svg+xml;base64," alt="Auction Champ" style="height:16px; vertical-align:middle; display:inline-block; margin-left:4px;"/></span></td><td style="padding:0; width:30%;"></td></tr></table>
                    </div>

                </div>
            </body>
        </html>
    </template>

    <!-- ── Standalone strawberry report ── -->
    <template id="report_player_card_list_strawberry">
        <t t-foreach="docs" t-as="doc">
            <t t-if="doc.tournament_id.tournament_type == 'football'">
                <page t-call="web.basic_layout">
                    <t t-call="auction_module.report_player_card_football_page"/>
                </page>
            </t>
            <t t-else="">
                <page t-call="web.basic_layout">
                    <t t-call="auction_module.report_player_card_strawberry_page"/>
                </page>
            </t>
        </t>
    </template>

</odoo>
