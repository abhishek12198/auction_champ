<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="live_board_public_style" name="Live Board Public Style">
  <style>
    :root {
      --lb-bg: #070c18;
      --lb-surface: #0d1526;
      --lb-border: rgba(255,255,255,0.08);
      --lb-accent: #3b72e8;
      --lb-accent2: #f4c542;
      --lb-glow: rgba(59,114,232,0.32);
      --lb-text: #e8edf8;
      --lb-sub: #8896b3;
      --lb-card: rgba(255,255,255,0.04);
    }
    [data-theme="cherry"] {
      --lb-bg: #110206; --lb-surface: #180306; --lb-accent: #e02626; --lb-accent2: #f4c542;
      --lb-glow: rgba(220,38,38,0.32); --lb-text: #fef0f0; --lb-sub: #f0948a;
    }
    [data-theme="butterscotch"] {
      --lb-bg: #0e0800; --lb-surface: #150b00; --lb-accent: #d97706; --lb-accent2: #fbbf24;
      --lb-glow: rgba(217,119,6,0.32); --lb-text: #fef3c7; --lb-sub: #d4a843;
    }
    [data-theme="strawberry"] {
      --lb-bg: #0d0010; --lb-surface: #160018; --lb-accent: #db2777; --lb-accent2: #f472b6;
      --lb-glow: rgba(219,39,119,0.32); --lb-text: #fdf2f8; --lb-sub: #f0abca;
    }
    [data-theme="blueberry"] {
      --lb-bg: #050a14; --lb-surface: #0a1220; --lb-accent: #3B82F6; --lb-accent2: #93C5FD;
      --lb-glow: rgba(59,130,246,0.35); --lb-text: #ffffff; --lb-sub: #93c5fd;
    }
    [data-theme="standard"] {
      --lb-bg: #f4f7fb; --lb-surface: #ffffff; --lb-border: #e2e8f0; --lb-accent: #1058B0;
      --lb-accent2: #1058B0; --lb-glow: rgba(16,88,176,0.12); --lb-text: #1a202c; --lb-sub: #4a5568;
      --lb-card: #f8fafc;
    }
    [data-theme="blackberry"] {
      --lb-bg: #101113; --lb-surface: #222328; --lb-accent: #7629D9; --lb-accent2: #A77BFF;
      --lb-glow: rgba(118,41,217,0.28); --lb-text: #ffffff; --lb-sub: #bfc3cc;
    }
    [data-theme="pistah"] {
      --lb-bg: #050d05; --lb-surface: #0b1a0b; --lb-accent: #16a34a; --lb-accent2: #4ade80;
      --lb-glow: rgba(34,197,94,0.30); --lb-text: #f0fdf4; --lb-sub: #86efac;
    }
    [data-theme="lemon"] {
      --lb-bg: #12100a; --lb-surface: #1a1608; --lb-accent: #E8C200; --lb-accent2: #F5D84A;
      --lb-glow: rgba(232,194,0,0.32); --lb-text: #fffdf0; --lb-sub: #c9b86a;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      font-family: 'Montserrat', system-ui, sans-serif;
      background: var(--lb-bg);
      color: var(--lb-text);
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 45% at 50% -10%, var(--lb-glow), transparent 60%),
        linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
      background-size: auto, 48px 48px, 48px 48px;
      pointer-events: none;
      z-index: 0;
    }
    .lb-wrap { position: relative; z-index: 1; }
  </style>
</template>

<template id="live_board_teaser_template" name="Live Board Auction Teaser">
<t t-set="theme_val" t-value="theme or 'vanilla'"/>
<html t-att-data-theme="theme_val" lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <t t-call="auction_module.social_preview_head">
    <t t-set="og_page_key" t-value="'live_board'"/>
    <t t-set="og_record" t-value="tournament"/>
  </t>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&amp;family=Rajdhani:wght@600;700&amp;display=swap" rel="stylesheet"/>
  <t t-call="auction_module.live_board_public_style"/>
  <style>
    .lb-teaser {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 28px 16px 40px;
    }
    .lb-teaser-card {
      width: min(640px, 100%);
      text-align: center;
      background: var(--lb-surface);
      border: 1px solid var(--lb-border);
      border-radius: 24px;
      padding: 40px 28px 32px;
      box-shadow: 0 18px 60px rgba(0,0,0,0.35);
    }
    .lb-logo {
      width: 112px;
      height: 112px;
      object-fit: contain;
      border-radius: 22px;
      background: rgba(255,255,255,0.04);
      margin: 0 auto 18px;
      display: block;
      box-shadow: 0 10px 30px var(--lb-glow);
    }
    .lb-logo-ph {
      width: 112px;
      height: 112px;
      margin: 0 auto 18px;
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      background: var(--lb-card);
      border: 1px solid var(--lb-border);
    }
    .lb-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(244,197,66,0.12);
      border: 1px solid rgba(244,197,66,0.45);
      color: var(--lb-accent2);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
    .lb-kicker-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--lb-accent2);
      box-shadow: 0 0 0 0 rgba(244,197,66,0.7);
      animation: lb-pulse 1.8s infinite;
    }
    @keyframes lb-pulse {
      70% { box-shadow: 0 0 0 8px rgba(244,197,66,0); }
      100% { box-shadow: 0 0 0 0 rgba(244,197,66,0); }
    }
    h1 {
      font-family: 'Rajdhani', 'Montserrat', sans-serif;
      font-size: clamp(1.8rem, 5vw, 2.7rem);
      line-height: 1.05;
      letter-spacing: 0.02em;
      margin: 18px 0 8px;
    }
    .lb-sub {
      color: var(--lb-sub);
      font-size: 1rem;
      margin: 0 0 26px;
    }
    .lb-facts {
      display: grid;
      gap: 12px;
      text-align: left;
      margin-bottom: 22px;
    }
    .lb-fact {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      padding: 14px 16px;
      border-radius: 14px;
      background: var(--lb-card);
      border: 1px solid var(--lb-border);
    }
    .lb-fact-mark {
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--lb-glow);
      color: var(--lb-accent2);
      font-size: 1rem;
    }
    .lb-fact-label {
      display: block;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--lb-sub);
      margin-bottom: 2px;
    }
    .lb-fact-value { font-weight: 700; line-height: 1.35; }
    .lb-note {
      color: var(--lb-sub);
      font-size: 0.88rem;
      line-height: 1.6;
      margin: 0;
    }
    @media (max-width: 520px) {
      .lb-teaser-card { padding: 28px 16px 24px; border-radius: 18px; }
      .lb-logo, .lb-logo-ph { width: 88px; height: 88px; }
    }
  </style>
</head>
<body>
  <div class="lb-wrap lb-teaser">
    <div class="lb-teaser-card">
      <t t-if="logo_url">
        <img class="lb-logo" t-att-src="logo_url" t-att-alt="tournament.name"/>
      </t>
      <t t-else="">
        <div class="lb-logo-ph">🏆</div>
      </t>
      <div class="lb-kicker"><span class="lb-kicker-dot"/> Auction Teaser</div>
      <h1><t t-esc="tournament.name"/></h1>
      <p class="lb-sub">The player auction is on its way.</p>
      <div class="lb-facts">
        <div class="lb-fact">
          <div class="lb-fact-mark">📅</div>
          <div>
            <span class="lb-fact-label">Auction starts</span>
            <div class="lb-fact-value">
              <t t-if="date_label"><t t-esc="date_label"/></t>
              <t t-else="">Date to be announced</t>
            </div>
          </div>
        </div>
        <div class="lb-fact">
          <div class="lb-fact-mark">📍</div>
          <div>
            <span class="lb-fact-label">Venue</span>
            <div class="lb-fact-value">
              <t t-if="venue"><t t-esc="venue"/></t>
              <t t-else="">Venue to be announced</t>
            </div>
          </div>
        </div>
      </div>
      <p class="lb-note">Live updates will open on this page when the auction begins.</p>
    </div>
  </div>
  <script>
    (function () {
      var dataUrl = window.location.href.split('?')[0].replace(/\/$/, '') + '/data';
      function check() {
        fetch(dataUrl)
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.live_board_active || d.auction_complete) {
              window.location.reload();
            }
          })
          .catch(function () {});
      }
      setInterval(check, 15000);
    })();
  </script>
</body>
</html>
</template>

<template id="live_board_squads_template" name="Live Board Team Squads">
<t t-set="theme_val" t-value="theme or 'vanilla'"/>
<html t-att-data-theme="theme_val" lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <t t-call="auction_module.social_preview_head">
    <t t-set="og_page_key" t-value="'squad'"/>
    <t t-set="og_record" t-value="tournament"/>
  </t>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&amp;family=Rajdhani:wght@600;700&amp;display=swap" rel="stylesheet"/>
  <t t-call="auction_module.live_board_public_style"/>
  <style>
    .lb-squad {
      width: min(1120px, 100%);
      margin: 0 auto;
      padding: 20px 16px 48px;
    }
    .lb-hero {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px;
      border-radius: 20px;
      background: var(--lb-surface);
      border: 1px solid var(--lb-border);
      margin-bottom: 18px;
    }
    .lb-hero img, .lb-hero-ph {
      width: 72px;
      height: 72px;
      border-radius: 16px;
      object-fit: contain;
      background: rgba(255,255,255,0.04);
      flex: 0 0 72px;
    }
    .lb-hero-ph {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
    }
    .lb-hero h1 {
      font-family: 'Rajdhani', 'Montserrat', sans-serif;
      font-size: clamp(1.4rem, 3vw, 2rem);
      margin: 4px 0 6px;
      line-height: 1.05;
    }
    .lb-eyebrow {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--lb-accent2);
    }
    .lb-meta { color: var(--lb-sub); font-size: 0.85rem; line-height: 1.45; }
    .lb-team {
      background: var(--lb-surface);
      border: 1px solid var(--lb-border);
      border-radius: 18px;
      margin-bottom: 16px;
      overflow: hidden;
    }
    .lb-team-head {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 16px;
      border-bottom: 1px solid var(--lb-border);
    }
    .lb-team-id {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .lb-team-logo, .lb-team-ph {
      width: 64px;
      height: 64px;
      border-radius: 14px;
      object-fit: cover;
      background: var(--lb-card);
      flex: 0 0 64px;
    }
    .lb-team-ph {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
    }
    .lb-team-meta { flex: 1 1 180px; min-width: 0; }
    .lb-team-meta h2 {
      margin: 0 0 6px;
      font-size: 1.15rem;
    }
    .lb-owner { display: flex; align-items: center; gap: 8px; color: var(--lb-sub); font-size: 0.85rem; }
    .lb-owner img, .lb-owner-ph {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--lb-card);
    }
    .lb-owner-ph {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
    }
    .lb-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .lb-stat {
      flex: 1 1 180px;
      min-width: 0;
      background: var(--lb-card);
      border: 1px solid var(--lb-border);
      border-radius: 12px;
      padding: 8px 12px;
    }
    .lb-stat-label {
      display: block;
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--lb-sub);
      margin-bottom: 2px;
    }
    .lb-stat-value {
      display: block;
      font-weight: 800;
      font-size: 0.95rem;
      line-height: 1.3;
    }
    .lb-players {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
      gap: 14px;
      padding: 16px;
    }
    .lb-player { text-align: center; min-width: 0; }
    .lb-player img, .lb-player-ph {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      object-position: center center;
      border-radius: 14px;
      background: var(--lb-card);
      display: block;
    }
    .lb-player.is-icon img, .lb-player.is-icon .lb-player-ph {
      box-shadow: 0 0 0 2px var(--lb-accent2);
    }
    .lb-player-ph {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--lb-sub);
    }
    .lb-player-name {
      display: block;
      margin-top: 8px;
      font-size: 0.82rem;
      font-weight: 800;
      line-height: 1.25;
      text-transform: uppercase;
    }
    .lb-player-role, .lb-player-pts {
      display: block;
      color: var(--lb-sub);
      font-size: 0.72rem;
      margin-top: 2px;
    }
    .lb-player-pts { color: var(--lb-accent2); font-weight: 700; }
    .lb-back {
      display: inline-flex;
      align-items: center;
      margin-bottom: 12px;
      color: var(--lb-accent2);
      font-weight: 800;
      font-size: 0.85rem;
      text-decoration: none;
    }
    .lb-empty { padding: 8px 16px 18px; color: var(--lb-sub); margin: 0; }
    .lb-none { color: var(--lb-sub); text-align: center; padding: 24px 8px; }
    @media (max-width: 640px) {
      .lb-squad { padding: 12px 10px 36px; }
      .lb-hero { align-items: flex-start; }
      .lb-hero img, .lb-hero-ph { width: 56px; height: 56px; flex-basis: 56px; }
      .lb-players { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .lb-stat { flex-basis: 100%; }
    }
  </style>
</head>
<body t-att-data-status-url="'/%s/%s/auction/live-board/data' % (db_name, tournament.slug)">
  <div class="lb-wrap lb-squad">
    <a t-if="profile_url" class="lb-back" t-att-href="profile_url">← Tournament</a>
    <header class="lb-hero">
      <t t-if="logo_url">
        <img t-att-src="logo_url" t-att-alt="tournament.name"/>
      </t>
      <t t-else="">
        <div class="lb-hero-ph">🏆</div>
      </t>
      <div>
        <div class="lb-eyebrow">Auction complete</div>
        <h1><t t-esc="tournament.name"/></h1>
        <div class="lb-meta">
          Team squads
          <t t-if="date_label"> · <t t-esc="date_label"/></t>
          <t t-if="venue"> · <t t-esc="venue"/></t>
        </div>
      </div>
    </header>

    <t t-if="not teams">
      <p class="lb-none">No teams have been added for this tournament yet.</p>
    </t>
    <t t-foreach="teams" t-as="team">
      <article class="lb-team">
        <header class="lb-team-head">
          <div class="lb-team-id">
            <t t-if="team.get('logo_url')">
              <img class="lb-team-logo" t-att-src="team.get('logo_url')" t-att-alt="team.get('name')"/>
            </t>
            <t t-else="">
              <div class="lb-team-ph">🛡️</div>
            </t>
            <div class="lb-team-meta">
              <h2><t t-esc="team.get('name')"/></h2>
              <t t-if="team.get('owner_name')">
                <div class="lb-owner">
                  <t t-if="team.get('owner_photo_url')">
                    <img t-att-src="team.get('owner_photo_url')" alt=""/>
                  </t>
                  <t t-else="">
                    <span class="lb-owner-ph">👤</span>
                  </t>
                  <span>Owner · <t t-esc="team.get('owner_name')"/></span>
                </div>
              </t>
            </div>
          </div>
          <div class="lb-stats">
            <div class="lb-stat">
              <span class="lb-stat-label">Total / spent</span>
              <span class="lb-stat-value">
                <t t-esc="team.get('total_label')"/> / <t t-esc="team.get('spent_label')"/>
              </span>
            </div>
            <div class="lb-stat">
              <span class="lb-stat-label">Max / squad</span>
              <span class="lb-stat-value">
                <t t-esc="team.get('max_players') or 0"/> / <t t-esc="team.get('squad_count') or 0"/>
              </span>
            </div>
          </div>
        </header>
        <t t-if="team.get('players')">
          <div class="lb-players">
            <t t-foreach="team.get('players')" t-as="player">
              <div t-att-class="'lb-player' + (' is-icon' if player.get('is_icon') else '')">
                <t t-if="player.get('photo_url')">
                  <img t-att-src="player.get('photo_url')" t-att-alt="player.get('name')" loading="lazy"/>
                </t>
                <t t-else="">
                  <div class="lb-player-ph"><t t-esc="(player.get('name') or '?')[:1]"/></div>
                </t>
                <span class="lb-player-name"><t t-esc="player.get('name')"/></span>
                <t t-if="player.get('role')">
                  <span class="lb-player-role"><t t-esc="player.get('role')"/></span>
                </t>
                <t t-if="player.get('points_label')">
                  <span class="lb-player-pts"><t t-esc="player.get('points_label')"/></span>
                </t>
              </div>
            </t>
          </div>
        </t>
        <t t-else="">
          <p class="lb-empty">No players in this squad yet.</p>
        </t>
      </article>
    </t>
  </div>
  <script>
    (function () {
      var dataUrl = document.body.getAttribute('data-status-url');
      function check() {
        fetch(dataUrl)
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.live_board_active || d.auction_complete === false) {
              window.location.reload();
            }
          })
          .catch(function () {});
      }
      setInterval(check, 15000);
    })();
  </script>
</body>
</html>
</template>
</odoo>
