<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auction_location_search" model="ir.ui.view">
        <field name="name">auction.location.search</field>
        <field name="model">auction.location</field>
        <field name="arch" type="xml">
            <search string="City / Location">
                <field name="name"/>
                <field name="complete_name"/>
                <field name="state_id"/>
                <field name="country_id"/>
                <field name="parent_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state_id'}"/>
                    <filter string="Parent" name="group_parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_auction_location_tree" model="ir.ui.view">
        <field name="name">auction.location.tree</field>
        <field name="model">auction.location</field>
        <field name="arch" type="xml">
            <tree string="City / Location">
                <field name="complete_name"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="state_id"/>
                <field name="country_id"/>
            </tree>
        </field>
    </record>

    <record id="view_auction_location_form" model="ir.ui.view">
        <field name="name">auction.location.form</field>
        <field name="model">auction.location</field>
        <field name="arch" type="xml">
            <form string="City / Location">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Kozhikode"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="complete_name" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="state_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Child Locations" name="children">
                            <field name="child_ids" nolabel="1"
                                   context="{'default_parent_id': active_id, 'default_country_id': country_id, 'default_state_id': state_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="state_id"/>
                                    <field name="country_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auction_location" model="ir.actions.act_window">
        <field name="name">City / Location Master</field>
        <field name="res_model">auction.location</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_auction_location_search"/>
        <field name="groups_id" eval="[(4, ref('auction_module.group_auction_group_admin'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a city or location
            </p>
            <p>
                Use Parent to nest a city under a district or region.
                Country and State come from the standard Odoo address masters.
            </p>
        </field>
    </record>
</odoo>
