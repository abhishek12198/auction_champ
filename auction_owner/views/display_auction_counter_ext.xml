<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove the Counter FAB from display_auction (HUD + sell-modal script). -->
    <delete model="ir.ui.view" search="[('key','=','auction_owner.player_sell_modal_counter_ext')]"/>
    <delete model="ir.ui.view" search="[('key','=','auction_owner.player_template_hud_counter_ext')]"/>
    <delete model="ir.model.data" search="[('module','=','auction_owner'),('name','in',['player_sell_modal_counter_ext','player_template_hud_counter_ext'])]"/>

    <!-- Leftover owner sell-modal inherit if an older upgrade left it. -->
    <delete model="ir.ui.view" search="[('key','=','auction_owner.player_sell_modal_bid_ext')]"/>
    <delete model="ir.model.data" search="[('module','=','auction_owner'),('name','=','player_sell_modal_bid_ext')]"/>

    <!-- Leftover per-theme display_auction inherits. -->
    <delete model="ir.ui.view" search="[('key','=','auction_owner.player_template_new_counter_ext')]"/>
    <delete model="ir.ui.view" search="[('key','=','auction_owner.player_template_butterscotch_counter_ext')]"/>
    <delete model="ir.ui.view" search="[('key','=','auction_owner.player_template_strawberry_counter_ext')]"/>
    <delete model="ir.ui.view" search="[('key','=','auction_owner.player_template_cherry_counter_ext')]"/>
    <delete model="ir.ui.view" search="[('key','=','auction_owner.player_template_pistah_counter_ext')]"/>
    <delete model="ir.model.data" search="[('module','=','auction_owner'),('name','in',['player_template_new_counter_ext','player_template_butterscotch_counter_ext','player_template_strawberry_counter_ext','player_template_cherry_counter_ext','player_template_pistah_counter_ext'])]"/>
</odoo>
